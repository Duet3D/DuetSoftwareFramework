{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "native",
      "displayName": "Native (dev box / build on the Pi)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "pi-arm64",
      "displayName": "Cross-compile for 64-bit Raspberry Pi OS (aarch64)",
      "binaryDir": "${sourceDir}/build-arm64",
      "toolchainFile": "${sourceDir}/cmake/aarch64-linux-gnu.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "native", "configurePreset": "native" },
    { "name": "pi-arm64", "configurePreset": "pi-arm64" }
  ]
}
