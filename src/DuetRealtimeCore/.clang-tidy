---
# The shared checks are in the repository's root .clang-tidy; this adds DuetRealtimeCore's naming
# style, and turns back on the checks the root switches off for reasons particular to the firmware
# (bare-metal startup and fault handlers, single-precision constants, -fno-threadsafe-statics, ...),
# which this hosted library does not share.
InheritParentConfig: true

Checks: >
  readability-identifier-naming,
  cppcoreguidelines-avoid-const-or-ref-data-members,
  cppcoreguidelines-macro-to-enum,
  modernize-macro-to-enum,
  bugprone-macro-parentheses,
  readability-redundant-declaration,
  bugprone-reserved-identifier,
  modernize-use-std-numbers,
  cppcoreguidelines-use-default-member-init,
  bugprone-dynamic-static-initializers

# Anchored to this project's own sources. A bare 'src/.*' would also match the shared
# wire-protocol headers under lib/DuetSpiInterface/, which DuetCANMaster compiles against --
# fixing headers there would silently change a project that is out of scope.
HeaderFilterRegex: '/src/DuetRealtimeCore/.*'

CheckOptions:
  # The cleanup/reconnect paths deliberately swallow failures because there is no fallback left
  # at that point. Each such catch says so and is tagged @intentional; clang-tidy 18 has no
  # AllowEmptyCatchWithComment, so the keyword list is how an explained catch is accepted.
  - key: bugprone-empty-catch.IgnoreCatchWithKeywords
    value: '@TODO;@FIXME;@intentional'
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase
  # The extern "C" ABI in CApi.h is bound by symbol name from
  # DuetControlServer/Link/Native/NativeMethods.cs. Renaming these would not fail the
  # build -- it would fail at runtime when P/Invoke cannot resolve the entry point.
  - key: readability-identifier-naming.FunctionIgnoredRegexp
    value: '^DuetRT_.*'
  - key: readability-identifier-naming.NamespaceCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.VariableCase
    value: camelBack
  - key: readability-identifier-naming.ConstantCase
    value: camelBack
  - key: readability-identifier-naming.ParameterCase
    value: camelBack
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: 'm_'
  - key: readability-identifier-naming.StaticVariablePrefix
    value: 's_'
  # Static data members of a class take the same s_ prefix as a file-scope static, so that a
  # reader can tell at the point of use which of the two kinds of member they are looking at.
  - key: readability-identifier-naming.ClassMemberCase
    value: camelBack
  - key: readability-identifier-naming.ClassMemberPrefix
    value: 's_'
