<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<PackageLicenseExpression>GPL-3.0</PackageLicenseExpression>
		<PublishTrimmed>true</PublishTrimmed>
		<PublishAot Condition="'$(AotPublish)' == 'true'">true</PublishAot>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\DuetAPIClient\DuetAPIClient.csproj" />
		<ProjectReference Include="..\DuetAPI\DuetAPI.csproj" />
		<ProjectReference Include="..\DuetSharedLibrary\DuetSharedLibrary.csproj" />
	</ItemGroup>
</Project>
