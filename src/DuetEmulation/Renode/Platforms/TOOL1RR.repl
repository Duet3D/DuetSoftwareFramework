// Duet 3 Tool 1RR (SAME51G19A).
using "SAME51.repl"

//
// The board's CAN bus is CAN0 (Config/TOOL1RR.h, CanParams). It has no address switches: its address is
// CanId::ToolBoardDefaultAddress unless one has been stored in its user area.

// DID: SAME51G19A, revision D
dsu:
    resetValues: "0x18:0x61810305"

// Analogue inputs, as fractions of the 3.3V reference (Config/TOOL1RR.h, the pin table), all on ADC0:
//   AIN0 VIN: 24V through the 60.4k/4.7k divider
//   AIN2 temp0, AIN7 temp1, AIN11 temp2: 100k thermistors at 25C against the 2.2k series resistors
//   AIN3 VSSA and AIN6 VREF monitors: the thermistors' ground and reference
adc0:
    channels: "0:0.525072,2:0.978474,3:0.0,6:1.0,7:0.978474,11:0.978474"
