<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
		<PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Description>Official remote HTTP API client for Duet3D boards (supports standalone and SBC mode)</Description>
		<PackageIcon>duet_teardrop_wifi_large.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IsTrimmable>true</IsTrimmable>
		<NoWarn>NETSDK1212</NoWarn>
		<!-- Shipped as a NuGet package, not deployed. Publishing it as part of the solution would
		     fail with NETSDK1129 because no single target framework can be picked. -->
		<IsPublishable>false</IsPublishable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\DuetAPI\DuetAPI.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\pkg\common\duet_teardrop_wifi_large.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>
</Project>
