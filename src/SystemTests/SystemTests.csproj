<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<IsPublishable>false</IsPublishable>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="nunit" Version="4.6.1" />
		<PackageReference Include="NUnit3TestAdapter" Version="6.2.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DuetAPI\DuetAPI.csproj" />
		<ProjectReference Include="..\DuetControlServer\DuetControlServer.csproj" />
	</ItemGroup>

	<!-- The scenarios run the real libduet_sbc.so, so building this project keeps the native
	     library current: a one-off CMake configure, then an incremental build that is a no-op when
	     nothing changed. Host/NativeLibraryLocator.cs resolves the result at run time. Opt out
	     with -p:BuildNativeLink=false, or pin a specific library by setting DUET_SBC_LIBRARY (which
	     also skips this, because a pinned library must not be rebuilt underneath the pin). -->
	<PropertyGroup>
		<BuildNativeLink Condition="'$(BuildNativeLink)' == '' and '$(DUET_SBC_LIBRARY)' == ''">true</BuildNativeLink>
		<NativeLinkDir>$(MSBuildThisFileDirectory)../DuetSbcInterface</NativeLinkDir>
	</PropertyGroup>
	<Target Name="BuildNativeLinkLibrary" BeforeTargets="Build" Condition="'$(BuildNativeLink)' == 'true'">
		<!-- The native build takes RRFLibraries from the submodule, and says so as a CMake command it
		     cannot find, which names neither the submodule nor the way to get it. A clone made
		     without recursing, and every new git worktree, starts without it. -->
		<Error Condition="!Exists('$(MSBuildThisFileDirectory)../../lib/RRFLibraries/RRFLibraries.cmake')"
		       Text="lib/RRFLibraries is not checked out, so libduet_sbc.so cannot be built. Check it out with 'git submodule update --init lib/RRFLibraries'." />

		<!-- cmake_install.cmake rather than CMakeCache.txt: the cache is written when the configure
		     starts, so a configure that failed leaves one behind and every later build then skips
		     straight to a build tree that was never generated. This file is written when the
		     configure finishes, so a failed one is retried instead of being taken for a good tree. -->
		<Exec Command="cmake --preset native-debug" WorkingDirectory="$(NativeLinkDir)"
		      Condition="!Exists('$(NativeLinkDir)/build/native-debug/cmake_install.cmake')" />
		<Exec Command="cmake --build --preset native-debug --target duet_sbc_shared --parallel" WorkingDirectory="$(NativeLinkDir)" />
	</Target>
</Project>
