{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "DuetAPI/bin/Release/net10.0/DuetAPI.dll",
            "DuetAPIClient/bin/Release/net10.0/DuetAPIClient.dll",
            "DuetControlServer/bin/Release/net10.0/DuetControlServer.dll",
            "DuetWebServer/bin/Release/net10.0/DuetWebServer.dll"
          ],
          "src": "../"
        }
      ],
      "dest": "api",
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      },
      {
        "src": "../DuetAPI",
        "files": [
          "DuetAPI.xml"
        ]
      }
    ],
    "overwrite": [
      {
        "files": [
          "apidoc/**.md"
        ],
        "exclude": [
          "obj/**"
        ]
      }
    ],
    "dest": "../../docs",
    "globalMetadata": {
      "_disableContribution": true
    },
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [
      "default",
      "modern"
    ],
    "postProcessors": [],
    "markdownEngineName": "markdig",
    "noLangKeyword": false,
    "keepFileLink": false,
    "cleanupCacheHistory": false,
    "disableGitFeatures": false
  }
}