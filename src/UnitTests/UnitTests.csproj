<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<IsPublishable>false</IsPublishable>
		<!-- The older tests were written before the rest of the tree turned nullability on and would
		     produce a lot of noise under the full 'enable'. 'annotations' lets the newer tests write
		     '?' where they mean it without asking the old ones to be annotated first. -->
		<Nullable>annotations</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="nunit" Version="4.6.1" />
		<PackageReference Include="NUnit3TestAdapter" Version="6.2.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
		<!-- Supplies the "XPlat Code Coverage" collector that scripts/coverage.sh drives. The
		     collector bundled with Test.Sdk emits a binary .coverage file that needs a separate
		     tool to read; coverlet writes cobertura directly and reports branch coverage. -->
		<PackageReference Include="coverlet.collector" Version="10.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DuetAPI\DuetAPI.csproj" />
		<ProjectReference Include="..\DuetControlServer\DuetControlServer.csproj" />
		<ProjectReference Include="..\DuetHttpClient\DuetHttpClient.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="File\GCodes\Circle.gcode">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
		<None Update="File\GCodes\config.g">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
		<None Update="File\GCodes\Cura.gcode">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
		<None Update="File\GCodes\Simplify3D.gcode">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
		<None Update="File\GCodes\Slic3r.gcode">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
		<None Update="Machine\JSON\patch.json">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
		<None Update="Machine\testModel.json">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
		<None Update="Utility\heightmap.csv">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>
