            "name": "SAMC21",
            "hidden": true,
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/toolchains/SAMC21.cmake"
        },
        {
            "name": "STM32H5",
            "hidden": true,
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/toolchains/STM32H5.cmake"
        },
        {
            "name": "RepRapFirmware",
            "hidden": true,
            "cacheVariables": {
                "DUET_PROJECT": "RepRapFirmware",
                "DUET_CLANG_TIDY": "OFF",
                "DUET_DISASSEMBLY": "ON"
            }
        },
        {
            "name": "Duet3Expansion",
            "hidden": true,
            "cacheVariables": {
                "DUET_PROJECT": "Duet3Expansion",
                "DUET_CLANG_TIDY": "OFF",
                "DUET_DISASSEMBLY": "ON"
            }
        },
        {
            "name": "Duet3Bootloader",
            "hidden": true,
            "cacheVariables": {
                "DUET_PROJECT": "Duet3Bootloader",
                "DUET_CLANG_TIDY": "OFF"
            }
