        {
            "name": "DuetCANMaster",
            "hidden": true,
            "cacheVariables": {
                "DUET_PROJECT": "DuetCANMaster",
                "DUET_DISASSEMBLY": "ON"
            }
        },
        {
            "name": "DuetRealtimeCore",
            "hidden": true,
            "description": "The SBC's native library: an ordinary hosted build, compiled for this machine unless a toolchain preset is inherited too. Its own CMakeLists.txt lints it, so the clang-tidy wiring of the firmware is not used.",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "DUET_PROJECT": "DuetRealtimeCore",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "DUET_REALTIME_CORE_CLANG_TIDY": "OFF"
            }
        },
        {
            "name": "aarch64-linux-gnu",
            "hidden": true,
            "description": "Cross-compile DuetRealtimeCore for aarch64 against this container's libraries. The devcontainer is Debian Bookworm, so its cross toolchain targets the same glibc 2.36 as Raspberry Pi OS Bookworm and the library loads there as-is.",
            "toolchainFile": "${sourceDir}/src/DuetRealtimeCore/cmake/aarch64-linux-gnu.cmake"
        },
        {
            "name": "arm-linux-gnueabihf",
            "hidden": true,
            "description": "As aarch64-linux-gnu, for a 32-bit Raspberry Pi OS install.",
            "toolchainFile": "${sourceDir}/src/DuetRealtimeCore/cmake/arm-linux-gnueabihf.cmake"
        },
        
