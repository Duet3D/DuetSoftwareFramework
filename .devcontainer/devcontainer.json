{
  "name": "DuetSoftwareFramework Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": true,
      "version": "latest"
    },
    "ghcr.io/devcontainers-extra/features/fish-apt-get:1": {},
    "ghcr.io/devcontainers-extra/features/ripgrep:1": {
      "version": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "editorconfig.editorconfig",
        "ms-vscode.cpptools",
        "ms-vscode.cpp-devtools",
        "ms-vscode.cmake-tools",
        "mcu-debug.rtos-views",
        "ms-python.python",
        "ms-python.autopep8",
        "ms-python.pylint",
        "rioj7.command-variable",
        "aaron-bond.better-comments",
        "everbright-it.sbomlens",
        "github.vscode-github-actions",
        "GitHub.vscode-pull-request-github"
      ],
      "settings": {
        "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
        "cmake.useCMakePresets": "always",
        // One project: every firmware board and DuetRealtimeCore, the SBC's native library, is a preset
        "cmake.sourceDirectory": "${workspaceFolder}",
        "markdown.copyFiles.destination": {
          "**/*.md": "/docs/images/${fileName}"
        }
      }
    }
  },
  "postCreateCommand": "dotnet --info && (cd src && dotnet restore DuetSoftwareFramework.sln) && python3 scripts/internal/create_settings.py",
  "postStartCommand": ".devcontainer/claude-persist.sh && echo 'Ready: run the `Build and Deploy` task or `cd src && dotnet build DuetSoftwareFramework.sln`'",
	"runArgs": [
		"--add-host=host.docker.internal:host-gateway"
	],

  "remoteUser": "vscode"
}