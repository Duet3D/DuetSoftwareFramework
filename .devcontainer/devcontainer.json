{
  "name": "DuetSoftwareFramework Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers-extra/features/ripgrep": "latest",
    "ghcr.io/devcontainers/features/github-cli": "latest"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "editorconfig.editorconfig",
        "ms-vscode.cpptools",
        "ms-vscode.cpp-devtools",
        "ms-vscode.makefile-tools",
        "ms-vscode.cmake-tools",
        "mcu-debug.rtos-views",
        "ms-python.python",
        "ms-python.autopep8",
        "ms-python.pylint",
        "rioj7.command-variable",
        "aaron-bond.better-comments",
        "everbright-it.sbomlens",
        "github.vscode-github-actions",
        "GitHub.vscode-pull-request-github"
      ],
      "settings": {
        "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
        "cmake.useCMakePresets": "always",
        // The firmware (every board a preset) and DuetRealtimeCore, the SBC's native library
        "cmake.sourceDirectory": [
          "${workspaceFolder}",
          "${workspaceFolder}/src/DuetRealtimeCore"
        ],
        "makefile.makefilePath": "${workspaceFolder}/Makefile.firmware",
        "makefile.configurations": [
          { "name": "Release", "makeArgs": ["-j16"] },
          { "name": "Debug", "makeArgs": ["-j16", "DEBUG=1"] }
        ],
        "makefile.dryrunSwitches": ["--always-make", "--keep-going", "--print-directory", "-j1"],
        "markdown.copyFiles.destination": {
          "**/*.md": "/docs/images/${fileName}"
        }
      }
    }
  },
  "postCreateCommand": "dotnet --info && (cd src && dotnet restore DuetSoftwareFramework.sln) && python3 scripts/create_settings.py",
  "postStartCommand": ".devcontainer/claude-persist.sh && echo 'Ready: run the `Build and Deploy` task or `cd src && dotnet build DuetSoftwareFramework.sln`'",
	"runArgs": [
		"--add-host=host.docker.internal:host-gateway"
	],

  "remoteUser": "vscode"
}