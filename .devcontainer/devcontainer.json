{
  "name": "DuetSoftwareFramework Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers-extra/features/ripgrep": "latest",
    "ghcr.io/devcontainers/features/github-cli": "latest"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "editorconfig.editorconfig",
        "ms-vscode.cpptools",
        "ms-vscode.makefile-tools",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "rioj7.command-variable",
        "github.vscode-github-actions"
      ],
      "settings": {
        "cmake.sourceDirectory": [
          "${workspaceFolder}/src/DuetCANMaster",
          "${workspaceFolder}/src/DuetSbcInterface"
        ]
      }
    }
  },
  "postCreateCommand": "dotnet --info && (cd src && dotnet restore DuetSoftwareFramework.sln) && python3 scripts/create_settings.py",
  "postStartCommand": ".devcontainer/claude-persist.sh && echo 'Ready: run the `Build and Deploy` task or `cd src && dotnet build DuetSoftwareFramework.sln`'",
	"runArgs": [
		"--add-host=host.docker.internal:host-gateway"
	],

  "remoteUser": "vscode"
}