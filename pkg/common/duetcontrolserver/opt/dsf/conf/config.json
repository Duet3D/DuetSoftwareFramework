{
  "AutoUpdateFirmware": true,
  "PluginSupport": true,
  "RootPluginSupport": false,
  "DisablePluginInstallations": false,
  "PluginsFilename": "/opt/dsf/conf/plugins.txt",
  "PluginAutoRestartInterval": 2000,
  "LogLevel": "info",
  "SocketDirectory": "/run/dsf",
  "SocketFile": "dcs.sock",
  "StartErrorFile": "/run/dsf/dcs.err",
  "Backlog": 4,
  "BaseDirectory": "/opt/dsf/sd",
  "PluginDirectory": "/opt/dsf/plugins",
  "HostUpdateInterval": 4000,
  "MaxMessageAge": 60,
  "SpiDevice": "/dev/spidev0.0",
  "CommunicationMethod": "spi",
  "SbcBufferSize": 8192,
  "SpiTransferMode": 0,
  "SpiFrequency": 8000000,
  "SbcConnectTimeout": 500,
  "SbcTransferTimeout": 500,
  "SbcConnectionTimeout": 4000,
  "MaxSbcRetries": 3,
  "GpioChipDevice": "/dev/gpiochip0",
  "TransferReadyPin": 25,
  "UsbDevice": "/dev/ttyACM1",
  "UsbReadTimeout": 2000,
  "UsbWriteTimeout": 2000,
  "CpuTemperaturePath": "/sys/class/thermal/thermal_zone0/temp",
  "CpuTemperatureDivider": 1000,
  "BufferedPrintCodes": 32,
  "BufferedMacroCodes": 16,
  "MaxCodesPerInput": 32,
  "MaxCodeBufferSize": 384,
  "MaxMessageLength": 4096,
  "AllowCustomModelPatches": false,
  "FirmwareComments": [
    "printing object",
    "MESH",
    "process",
    "stop printing object",
    "layer",
    "LAYER",
    "BEGIN_LAYER_OBJECT z=",
    "HEIGHT",
    "PRINTING",
    "REMAINING_TIME"
  ],
  "ModelUpdateInterval": 100,
  "MaxMachineModelLockTime": -1,
  "FileBufferSize": 32768,
  "IpcJsonBufferSize": 1024,
  "FileInfoReadLimitHeader": 16384,
  "FileInfoReadLimitFooter": 262144,
  "MaxLayerHeight": 0.9,
  "LayerHeightFilters": [
    "^\\s*layer_height\\D+(?<mm>(\\d+\\.?\\d*))",
    "Layer height\\D+(?<mm>(\\d+\\.?\\d*))",
    "layerHeight\\D+(?<mm>(\\d+\\.?\\d*))",
    "layer_thickness_mm\\D+(?<mm>(\\d+\\.?\\d*))",
    "layerThickness\\D+(?<mm>(\\d+\\.?\\d*))",
    "sliceHeight\\D+(?<mm>(\\d+\\.?\\d*))"
  ],
  "NumLayersFilters": [
    "NUM_LAYERS\\D+(\\d+)"
  ],
  "FilamentFilters": [
    "filament used\\D+(((?<mm>\\d+\\.?\\d*)\\s*mm)(\\D+)?)+",
    "filament used\\D+(((?<m>\\d+\\.?\\d*)m([^m]|$))(\\D+)?)+",
    "filament length\\D+(((?<mm>\\d+\\.?\\d*)\\s*mm)(\\D+)?)+",
    "filament used \\[mm\\]\\D+((?<mm>\\d+\\.?\\d*)(\\D+)?)+",
    "material\\#(?<index>\\d+)\\D+(?<mm>\\d+\\.?\\d*)",
    "Ext\\s*\\#\\d+\\D+(?<mm>\\d+\\.?\\d*)",
    "Filament used per extruder:\\r\\n;\\s*(?<name>.+)\\s+=\\s*(?<mm>[0-9.]+)",
    "filament used extruder (?<index>\\d+) \\(mm\\) = (?<mm>\\d+\\.?\\d*)"
  ],
  "GeneratedByFilters": [
    "generated by\\s+(.+)",
    "Sliced by\\s+(.+)",
    "(KISSlicer.*)",
    "Sliced at:\\s*(.+)",
    "Generated with\\s*(.+)"
  ],
  "PrintTimeFilters": [
    "estimated printing time .*= ((?<d>(\\d+))d\\s*)?((?<h>(\\d+))h\\s*)?((?<m>(\\d+))m\\s*)?((?<s>(\\d+))s)?",
    "TIME:(?<s>(\\d+\\.?\\d*))",
    "Build Time:\\s+((?<h>(\\d+\\.?\\d*)) hour(s)?\\s*)?((?<m>(\\d+\\.?\\d*)) minute(s)?\\s*)?((?<s>(\\d+\\.?\\d*)) second(s)?)?",
    "print time:\\s+(?<s>(\\d+\\.?\\d*))(s)?",
    "Total estimated \\(pre-cool\\) minutes: ((?<m>\\d+\\.?\\d*))",
    "total print time \\(s\\) = (?<s>(\\d+\\.?\\d*))",
    "Build time:\\s+(?<h>(\\d+\\.?\\d*)):(?<m>(\\d+\\.?\\d*)):(?<s>(\\d+\\.?\\d*))"
  ],
  "SimulatedTimeFilters": [
    "Simulated print time\\D+(?<s>(\\d+\\.?\\d*))"
  ]
}