#!/bin/sh

# Set ownership and permissions
chown -R dsf:dsf /opt/dsf/conf/plugins*
chown dsf:dsf /opt/dsf/bin/pipInstall2.py 2>/dev/null || true
chmod 755 /opt/dsf/plugins
chmod 744 /opt/dsf/bin/pipInstall2.py 2>/dev/null || true

# Drop existing per-plugin AppArmor profiles so DPS regenerates them from the current template on its next start
rm -f /etc/apparmor.d/dsf.*

# Update systemd services
systemctl -q --no-ask-password daemon-reload

# Start DPS instances again if it is enabled via systemd
if (systemctl -q is-enabled duetpluginservice); then
    systemctl -q --no-ask-password start duetpluginservice || true
fi

if (systemctl -q is-enabled duetpluginservice-root); then
    systemctl -q --no-ask-password start duetpluginservice-root || true
fi

# Don't block the configuration of other packages if DPS failed to start
exit 0
