#!/bin/sh

# Create gpio group and add dsf to it
systemd-sysusers duetcontrolserver.conf

# Ensure dsf group memberships on upgrade. systemd-sysusers "m" lines are unreliable for
# pre-existing users on older systemd versions, so re-apply explicitly
for grp in gpio video dialout; do
    getent group "$grp" >/dev/null 2>&1 && usermod -a -G "$grp" dsf || true
done

# Create /var/run/dsf now
systemd-tmpfiles --create duetcontrolserver.conf

# Trigger assignment of gpio group to the existing devices
udevadm trigger

# Set ownership and permissions
chown -R dsf:dsf /opt/dsf/conf /opt/dsf/plugins
chmod -R g+wX /opt/dsf/conf
chmod 755 /opt/dsf/plugins

# File capabilities trigger AT_SECURE=1 on exec, which DPS verifies when DCS connects back
# to itself (e.g. `DuetControlServer -u`) to defend against LD_PRELOAD masquerade attacks.
# The IPC handshake rejects peers without AT_SECURE, so a failed setcap must not be silently
# ignored - warn loudly because DSF services will refuse to talk to each other otherwise
if ! setcap cap_sys_ptrace,cap_dac_read_search+ep /opt/dsf/bin/DuetControlServer; then
    echo "WARNING: failed to set file capabilities on DuetControlServer" >&2
    echo "         DSF services will refuse IPC connections until file capabilities can be set" >&2
    echo "         (check that /opt is on a filesystem supporting capabilities and not mounted nosuid)" >&2
fi

# Update systemd services
systemctl -q --no-ask-password daemon-reload

# Start DCS again if it is enabled via systemd
if (systemctl -q is-enabled duetcontrolserver); then
    systemctl -q --no-ask-password start duetcontrolserver
fi

# Ignore the return code of the DCS start request in case no board is connected
exit 0
