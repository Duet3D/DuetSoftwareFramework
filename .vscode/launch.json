{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Remote DuetControlServer",
            "type": "coreclr",
            "request": "launch",
            "program": "/opt/dsf/bin/DuetControlServer",
            "args": [],
            "cwd": "/opt/dsf/bin",
            "stopAtEntry": false,
            "pipeTransport": {
                "pipeCwd": "${workspaceFolder}",
                "pipeProgram": "ssh",
                "pipeArgs": [
                    "-T",
                    "${config:dsf.debug.sshUser}@${config:dsf.debug.targetIp}"
                ],
                "debuggerPath": "${config:dsf.debug.debuggerPath}",
                "quoteArgs": false
            },
            "sourceFileMap": {
                "/workspaces/DuetSoftwareFramework": "${workspaceFolder}"
            },
            "justMyCode": false,
            "preLaunchTask": "Stop Remote DuetControlServer",
            "postDebugTask": "Start Remote DuetControlServer"
        },
        {
            "name": "Attach Remote DuetControlServer",
            "type": "coreclr",
            "request": "attach",
            "processName": "DuetControlServer",
            "pipeTransport": {
                "pipeCwd": "${workspaceFolder}",
                "pipeProgram": "ssh",
                "pipeArgs": [
                    "-T",
                    "${config:dsf.debug.sshUser}@${config:dsf.debug.targetIp}"
                ],
                "debuggerPath": "${config:dsf.debug.debuggerPath}",
                "quoteArgs": true
            },
            "justMyCode": false
        }
    ]
}