{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "[DSF] Launch Remote DuetControlServer",
            "type": "coreclr",
            "request": "launch",
            "program": "/opt/dsf/bin/DuetControlServer",
            "args": [],
            "cwd": "/opt/dsf/bin",
            "stopAtEntry": false,
            "pipeTransport": {
                "pipeCwd": "${workspaceFolder}",
                "pipeProgram": "ssh",
                // The service's UMask, so that DuetWebServer, running as dsf, can connect to the IPC socket DCS creates
                "pipeArgs": [
                    "-T",
                    "${config:dsf.debug.sshUser}@${config:dsf.debug.targetIp}",
                    "umask 0002;"
                ],
                "debuggerPath": "${config:dsf.debug.debuggerPath}",
                "quoteArgs": false
            },
            "sourceFileMap": {
                "/workspaces/DuetSoftwareFramework": "${workspaceFolder}"
            },
            "justMyCode": false,
            // Otherwise the C# extension sends SHA384 and SHA512 source checksums, for which the remote vsdbg can reject
            // every breakpoint
            "requireExactSource": false,
            "preLaunchTask": "[DSF] Stop Remote DuetControlServer",
            "postDebugTask": "[DSF] Start Remote DuetControlServer"
        },
        {
            "name": "[DSF] Attach Remote DuetControlServer",
            "type": "coreclr",
            "request": "attach",
            "processName": "DuetControlServer",
            "pipeTransport": {
                "pipeCwd": "${workspaceFolder}",
                "pipeProgram": "ssh",
                "pipeArgs": [
                    "-T",
                    "${config:dsf.debug.sshUser}@${config:dsf.debug.targetIp}"
                ],
                "debuggerPath": "${config:dsf.debug.debuggerPath}",
                "quoteArgs": true
            },
            "justMyCode": false,
            // As in the launch configuration above
            "requireExactSource": false
        },
        {
            "name": "[DSF] Attach Native (lib*.so)",
            "type": "cppdbg",
            "request": "attach",
            "program": "/opt/dsf/bin/DuetControlServer",
            "preLaunchTask": "[DSF] Get DuetControlServer PID",
            "processId": "${input:dcs_pid}", // Unfortunately we can't use the process name
            "MIMode": "gdb",
            "pipeTransport": {
                "pipeProgram": "ssh",
                "pipeArgs": [
                    "-T",
                    "${config:dsf.debug.sshUser}@${config:dsf.debug.targetIp}"
                ],
                "pipeCwd": "${workspaceFolder}",
                "debuggerPath": "/usr/bin/gdb",
                "quoteArgs": true
            },
            "setupCommands": [
                {
                    "description": "Enable pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Allow pending breakpoints",
                    "text": "set breakpoint pending on"
                },
                // {
                //     "description": "Use hardware breakpoints",
                //     "text": "set breakpoint auto-hw on",
                //     "ignoreFailures": true
                // },
                // {
                //     "description": "Do not stop on shared library events",
                //     "text": "set stop-on-solib-events 0",
                //     "ignoreFailures": true
                // },
                // {
                //     "description": "Enable non-stop mode",
                //     "text": "set non-stop on",
                //     "ignoreFailures": true
                // },
                {
                    "description": "Do not stop other threads unnecessarily",
                    "text": "set scheduler-locking off",
                    "ignoreFailures": true
                },
                // {
                //     "description": "Ignore runtime debugger signals",
                //     "text": "handle SIGTRAP nostop noprint pass",
                //     "ignoreFailures": true
                // },
                // {
                //     "description": "Ignore SIGSTOP",
                //     "text": "handle SIGSTOP nostop noprint pass",
                //     "ignoreFailures": true
                // },
                // {
                //     "description": "Ignore SIGCHLD",
                //     "text": "handle SIGCHLD nostop noprint pass",
                //     "ignoreFailures": true
                // },
                {
                    "description": "Ignore .NET runtime realtime signal",
                    "text": "handle SIG34 nostop noprint pass",
                    "ignoreFailures": true
                }
            ]
        },
        // ---------------------------------------------------------------
        // Firmware: any DuetCANMaster, RepRapFirmware or Duet3Expansion board, picked from CMakePresets.json
        // ---------------------------------------------------------------
        {
            // The GDB server runs on the host, outside the devcontainer, so cortex-debug connects to it as an external
            // server and leaves out the commands it would send to one it started itself. The script for the server
            // picked defines duet-reset-halt, which halts the MCU at its reset vector, before the bootloader runs, so
            // that breakpoints in the startup code are hit
            "name": "[Firmware] Build, Flash & Debug",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "external",
            "gdbTarget": "${input:gdbServer}",
            "executable": "${workspaceFolder}/build/${input:board}-debug/vscode/firmware.elf",
            "svdFile": "${workspaceFolder}/build/${input:board}-debug/vscode/device.svd",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "[Firmware] Build Debug Firmware",
            "postDebugTask": "[Firmware] Restart Firmware",
            // Flash the .bin rather than the .elf: only the .bin has the CRC that the bootloaders check before starting
            // the firmware
            "overrideLaunchCommands": [
                "source ${workspaceFolder}/.vscode/gdb/${input:gdbServerType}.gdb",
                "duet-reset-halt",
                "set gnutarget binary",
                "eval \"load ${workspaceFolder}/build/${input:board}-debug/vscode/firmware.bin 0x%x\", &_sfixed",
                "set gnutarget auto",
                "duet-reset-halt"
            ],
            "overrideRestartCommands": ["duet-reset-halt"]
        },
        {
            // Debugs the image already built in the board's Debug build tree, restarting it from the reset vector as
            // Build, Flash & Debug does
            "name": "[Firmware] Debug Only",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "external",
            "gdbTarget": "${input:gdbServer}",
            "executable": "${workspaceFolder}/build/${input:board}-debug/vscode/firmware.elf",
            "svdFile": "${workspaceFolder}/build/${input:board}-debug/vscode/device.svd",
            "cwd": "${workspaceFolder}",
            "postDebugTask": "[Firmware] Restart Firmware",
            "overrideLaunchCommands": [
                "source ${workspaceFolder}/.vscode/gdb/${input:gdbServerType}.gdb",
                "duet-reset-halt"
            ],
            "overrideRestartCommands": ["duet-reset-halt"]
        },
        {
            // Flashes the bootloader with scripts/flash_bootloader.py, as GDB's load cannot write it while the
            // firmware has it protected, then restarts the board and halts it before the bootloader runs.
            // Like the script, it needs OpenOCD as the GDB server
            "name": "[Firmware] Flash & Debug Bootloader",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "external",
            "gdbTarget": "${input:gdbServer}",
            "executable": "${workspaceFolder}/build/${input:bootloader}-debug/vscode/firmware.elf",
            "svdFile": "${workspaceFolder}/build/${input:bootloader}-debug/vscode/device.svd",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "[Firmware] Build & Flash Debug Bootloader",
            "postDebugTask": "[Firmware] Restart Firmware",
            "overrideLaunchCommands": [
                "source ${workspaceFolder}/.vscode/gdb/${input:openocdServerType}.gdb",
                "duet-reset-halt"
            ],
            "overrideRestartCommands": ["duet-reset-halt"]
        },
        {
            // Prompts for any script in scripts/, then its arguments
            "name": "[Scripts] Debug Python Script",
            "type": "debugpy",
            "request": "launch",
            "program": "${input:pythonScript}",
            // A string rather than a list, so the arguments are split as a shell would
            "args": "${input:pythonScriptArgs}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ],
    "inputs": [
        {
            // The boards are the DuetCANMaster, RepRapFirmware and Duet3Expansion presets in CMakePresets.json; the
            // pick is remembered for the build task
            "id": "board",
            "type": "command",
            "command": "extension.commandvariable.pickStringRemember",
            "args": {
                "description": "Board to debug",
                "key": "board",
                "addLabelToTop": "${remember:board}",
                "fileName": "${workspaceFolder}/CMakePresets.json",
                "fileFormat": "json",
                "jsonOption": {
                    "label": "content.configurePresets.filter(p => !p.hidden && !p.name.endsWith('-debug') && ['DuetCANMaster', 'RepRapFirmware', 'Duet3Expansion'].includes(p.inherits[0]))[__itemIdx__].name",
                    "description": "content.configurePresets.filter(p => !p.hidden && !p.name.endsWith('-debug') && ['DuetCANMaster', 'RepRapFirmware', 'Duet3Expansion'].includes(p.inherits[0]))[__itemIdx__].displayName",
                    "value": "content.configurePresets.filter(p => !p.hidden && !p.name.endsWith('-debug') && ['DuetCANMaster', 'RepRapFirmware', 'Duet3Expansion'].includes(p.inherits[0]))[__itemIdx__].name"
                }
            }
        },
        {
            // The bootloaders are the Duet3Bootloader presets in CMakePresets.json, less the main boards' CAN IAPs, as in
            // tasks.json and scripts/flash_bootloader.py; the pick is remembered for the flash task, and shared with the
            // [Firmware] Flash Bootloader (SWD) task
            "id": "bootloader",
            "type": "command",
            "command": "extension.commandvariable.pickStringRemember",
            "args": {
                "description": "Bootloader to debug",
                "key": "bootloader",
                "addLabelToTop": "${remember:bootloader}",
                "fileName": "${workspaceFolder}/CMakePresets.json",
                "fileFormat": "json",
                "jsonOption": {
                    "label": "content.configurePresets.filter(p => !p.hidden && !p.name.endsWith('-debug') && p.inherits[0] === 'Duet3Bootloader' && !p.displayName.includes('CAN IAP'))[__itemIdx__].name",
                    "description": "content.configurePresets.filter(p => !p.hidden && !p.name.endsWith('-debug') && p.inherits[0] === 'Duet3Bootloader' && !p.displayName.includes('CAN IAP'))[__itemIdx__].displayName",
                    "value": "content.configurePresets.filter(p => !p.hidden && !p.name.endsWith('-debug') && p.inherits[0] === 'Duet3Bootloader' && !p.displayName.includes('CAN IAP'))[__itemIdx__].name"
                }
            }
        },
        {
            // Names the script in .vscode/gdb with the commands for the GDB server
            "id": "gdbServerType",
            "type": "command",
            "command": "extension.commandvariable.pickStringRemember",
            "args": {
                "description": "GDB server",
                "key": "gdbServerType",
                "addLabelToTop": "${remember:gdbServerType}",
                "options": [
                    { "label": "jlink", "description": "SEGGER J-Link GDB Server", "value": "jlink" },
                    { "label": "openocd", "description": "OpenOCD", "value": "openocd" },
                    { "label": "pyocd", "description": "pyOCD", "value": "pyocd" }
                ]
            }
        },
        {
            // For [Firmware] Flash & Debug Bootloader, which always uses OpenOCD: remembers it as the GDB server, for the
            // [Firmware] Restart Firmware task, without asking
            "id": "openocdServerType",
            "type": "command",
            "command": "extension.commandvariable.remember",
            "args": {
                "store": { "gdbServerType": "openocd" },
                "key": "gdbServerType"
            }
        },
        {
            // Remembered for the "[Firmware] Restart Firmware" task, which reconnects to it when the session ends
            "id": "gdbServer",
            "type": "command",
            "command": "extension.commandvariable.promptStringRemember",
            "args": {
                "key": "gdbServer",
                "description": "GDB server host:port (use host.docker.internal for a server running on the host outside the devcontainer)",
                "default": "host.docker.internal:2331"
            }
        },
        {
            // Every root script is runnable; the modules they share are in scripts/common
            "id": "pythonScript",
            "type": "command",
            "command": "extension.commandvariable.file.pickFile",
            "args": {
                "description": "Script to debug",
                "include": "scripts/*.py",
                "display": "fileName",
                "keyRemember": "pythonScript"
            }
        },
        {
            "id": "pythonScriptArgs",
            "type": "command",
            "command": "extension.commandvariable.promptStringRemember",
            "args": {
                "key": "pythonScriptArgs",
                "description": "Script arguments (blank for none, --help for usage)",
                "default": ""
            }
        },
        {
            "id": "dcs_pid",
            "type": "command",
            "command": "extension.commandvariable.file.content",
            "args": {
                "fileName": "${workspaceFolder}/.vscode/dcs.pid"
            }
        }
    ]
}