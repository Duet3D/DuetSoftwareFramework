{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "ip_address",
            "type": "promptString",
            "description": "IP address of SBC to deploy to"
        },
        {
            "id": "debug_target_ip",
            "type": "promptString",
            "description": "IP address of debug target SBC (saved to .vscode/settings.json)"
        },
        {
            "id": "ssh_user",
            "type": "promptString",
            "description": "SSH user for remote target",
            "default": "root"
        },
        {
            "id": "project_name",
            "type": "pickString",
            "description": "Project name to build",
            "options": [
                "dsf",
                "DuetControlServer",
                "DuetRealtimeCore",
                "DuetPiManagementPlugin",
                "DuetPluginService",
                "DuetWebServer",
                "PluginManager",
                "CodeConsole",
                "CodeLogger",
                "CodeStream",
                "CustomHttpEndpoint",
                "ModelObserver"
            ]
        },
        {
            "id": "dotnet_aot",
            "type": "pickString",
            "description": "Build DuetControlServer using native AOT compilation",
            "options": [
                "Yes",
                "No"
            ]
        },
        {
            // The boards are the CMake presets but DuetRealtimeCore's (rtc-*); the pick is remembered for "[Firmware] Build Debug Firmware",
            // which the firmware launch configurations run
            "id": "firmware_board",
            "type": "command",
            "command": "extension.commandvariable.pickStringRemember",
            "args": {
                "description": "Firmware board to build",
                "key": "board",
                "addLabelToTop": "${remember:board}",
                "fileName": "${workspaceFolder}/CMakePresets.json",
                "fileFormat": "json",
                "jsonOption": {
                    "label": "content.configurePresets.filter(p => !p.hidden && !p.name.endsWith('-debug') && !p.name.startsWith('rtc-'))[__itemIdx__].name",
                    "description": "content.configurePresets.filter(p => !p.hidden && !p.name.endsWith('-debug') && !p.name.startsWith('rtc-'))[__itemIdx__].displayName",
                    "value": "content.configurePresets.filter(p => !p.hidden && !p.name.endsWith('-debug') && !p.name.startsWith('rtc-'))[__itemIdx__].name"
                }
            }
        },
        {
            "id": "firmware_build_type",
            "type": "pickString",
            "description": "Firmware build type",
            "options": [
                { "label": "Release", "value": "" },
                { "label": "Debug", "value": "--debug" }
            ],
            "default": ""
        },
        {
            "id": "board",
            "type": "command",
            "command": "extension.commandvariable.remember",
            "args": { "key": "board" }
        },
        {
            "id": "gdbServer",
            "type": "command",
            "command": "extension.commandvariable.remember",
            "args": { "key": "gdbServer" }
        },
        {
            // The GDB server the debug session used, which launch.json remembers
            "id": "gdbServerType",
            "type": "command",
            "command": "extension.commandvariable.remember",
            "args": { "key": "gdbServerType" }
        },
        {
            "id": "bootloader",
            "type": "command",
            "command": "extension.commandvariable.remember",
            "args": { "key": "bootloader" }
        },
        {
            // The bootloaders are the Duet3Bootloader presets in CMakePresets.json, less the main boards' CAN IAPs, as in
            // launch.json and scripts/flash_bootloader.py. Shares its remembered pick with launch.json's bootloader input
            "id": "bootloaderPick",
            "type": "command",
            "command": "extension.commandvariable.pickStringRemember",
            "args": {
                "description": "Bootloader to flash",
                "key": "bootloader",
                "addLabelToTop": "${remember:bootloader}",
                "fileName": "${workspaceFolder}/CMakePresets.json",
                "fileFormat": "json",
                "jsonOption": {
                    "label": "content.configurePresets.filter(p => !p.hidden && !p.name.endsWith('-debug') && p.inherits[0] === 'Duet3Bootloader' && !p.displayName.includes('CAN IAP'))[__itemIdx__].name",
                    "description": "content.configurePresets.filter(p => !p.hidden && !p.name.endsWith('-debug') && p.inherits[0] === 'Duet3Bootloader' && !p.displayName.includes('CAN IAP'))[__itemIdx__].displayName",
                    "value": "content.configurePresets.filter(p => !p.hidden && !p.name.endsWith('-debug') && p.inherits[0] === 'Duet3Bootloader' && !p.displayName.includes('CAN IAP'))[__itemIdx__].name"
                }
            }
        },
        {
            // Shares its remembered value with the debug launch configurations' gdbServer input
            "id": "gdbServerPrompt",
            "type": "command",
            "command": "extension.commandvariable.promptStringRemember",
            "args": {
                "key": "gdbServer",
                "description": "GDB server host:port (use host.docker.internal for a server running on the host outside the devcontainer)",
                "default": "host.docker.internal:2331"
            }
        },
        {
            "id": "submoduleBranch",
            "type": "promptString",
            "description": "Branch to switch submodules to where it exists, e.g. 3.7-ch"
        },
        {
            "id": "duetHost",
            "type": "command",
            "command": "extension.commandvariable.promptStringRemember",
            "args": {
                "key": "duetHost",
                "description": "Main board host name or IP address",
                "default": "duet3.local"
            }
        },
        {
            "id": "duetPassword",
            "type": "promptString",
            "description": "Main board password (reprap if none is set)",
            "password": true,
            "default": "reprap"
        }
    ],
    "tasks": [
        {
            "label": "[DSF] Install vsdbg on Remote",
            "type": "shell",
            "command": "ssh -o StrictHostKeyChecking=no ${config:dsf.debug.sshUser}@${config:dsf.debug.targetIp} 'mkdir -p ~/vsdbg && curl -fsSL https://aka.ms/getvsdbgsh | bash /dev/stdin -v latest -l ~/vsdbg && ~/vsdbg/vsdbg --version'",
            "problemMatcher": []
        },
        {
            "label": "[DSF] Deploy To",
            "type": "shell",
            "command": "scripts/deploy.py $([ '${input:dotnet_aot}' = 'Yes' ] && echo --aot) --debug -H ${config:dsf.debug.targetIp} -u ${config:dsf.debug.sshUser} --start-services ${input:project_name}",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Deploy Local",
            "type": "shell",
            "command": "scripts/deploy.py $([ '${input:dotnet_aot}' = 'Yes' ] && echo --aot) --debug --local ${input:project_name}",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Build",
            "type": "shell",
            "command": "scripts/build.py $([ '${input:dotnet_aot}' = 'Yes' ] && echo --aot) --debug ${input:project_name}",
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Build and Deploy To",
            "type": "shell",
            "command": "scripts/deploy.py $([ '${input:dotnet_aot}' = 'Yes' ] && echo --aot) --build --debug -H ${config:dsf.debug.targetIp} -u ${config:dsf.debug.sshUser} --start-services ${input:project_name}",
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "options": {
                "env": {
                    "DSF_SSH_USER": "${config:dsf.debug.sshUser}",
                    "DSF_TARGET_IP": "${config:dsf.debug.targetIp}",
                    "WORKSPACE_FOLDER": "${workspaceFolder}"
                }
            }
        },
        {
            "label": "[DSF] Build and Deploy Local",
            "type": "shell",
            "command": "scripts/deploy.py $([ '${input:dotnet_aot}' = 'Yes' ] && echo --aot) --build --debug --local ${input:project_name}",
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Build and Deploy DCS to",
            "type": "shell",
            "command": "scripts/deploy.py $([ '${input:dotnet_aot}' = 'Yes' ] && echo --aot) --build --debug -H ${config:dsf.debug.targetIp} -u ${config:dsf.debug.sshUser} --start-services DuetControlServer",
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "options": {
                "env": {
                    "DSF_SSH_USER": "${config:dsf.debug.sshUser}",
                    "DSF_TARGET_IP": "${config:dsf.debug.targetIp}",
                    "WORKSPACE_FOLDER": "${workspaceFolder}"
                }
            }
        },
        {
            // Native SPI transfer loop (libduet_realtime_core.so). Cross-compiled for aarch64. The
            // devcontainer's glibc matches Raspberry Pi OS Bookworm's, so no sysroot is involved.
            "label": "[DSF] Build DuetRealtimeCore",
            "type": "shell",
            "command": "scripts/build.py --debug DuetRealtimeCore",
            // gcc's problem matcher, written out because $gcc only exists once the C/C++ extension is installed
            "problemMatcher": {
                "owner": "gcc",
                "source": "gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Build and Deploy DuetRealtimeCore to",
            "type": "shell",
            "command": "scripts/deploy.py --build --debug -H ${config:dsf.debug.targetIp} -u ${config:dsf.debug.sshUser} --start-services DuetRealtimeCore",
            "problemMatcher": {
                "owner": "gcc",
                "source": "gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            // Fetch a sysroot from the Pi. Not needed for Bookworm targets; only for cross-building
            // against a glibc older than the container's 2.36.
            "label": "[DSF] Fetch Pi Sysroot",
            "type": "shell",
            "command": "./src/DuetRealtimeCore/scripts/fetch-pi-sysroot.sh ${config:dsf.debug.sshUser}@${config:dsf.debug.targetIp} ./src/DuetRealtimeCore/pi-sysroot",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            // The C# test suite (DCS, DuetAPI, DuetHttpClient). Runs natively for the host.
            "label": "[DSF] Run C# Unit Tests",
            "type": "shell",
            "command": "scripts/test.py unit",
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "test",
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            // The C# test suite. Runs DCS & DuetRealtimeCore natively for the host.
            "label": "[DSF] Run C# System Tests",
            "type": "shell",
            "command": "scripts/test.py system",
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "test",
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            // Host-side unit tests for the native interface (ring buffer framing/concurrency).
            // Builds natively for the host, so no Pi or sysroot is involved.
            "label": "[DSF] Run Native Tests",
            "type": "shell",
            "command": "scripts/test.py native",
            "problemMatcher": {
                "owner": "gcc",
                "source": "gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "group": "test",
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            // Builds and deploys the jitter harness, which measures RequestTransfer -> transfer
            // latency without the .NET runtime. Statically linked, so it needs no sysroot.
            "label": "[DSF] Build and Deploy Jitter Harness to",
            "type": "shell",
            "command": "cmake --preset rtc-arm64 && cmake --build --preset rtc-arm64 --target realtime_core_jitter_test -j && scp build/rtc-arm64/realtime_core_jitter_test ${config:dsf.debug.sshUser}@${config:dsf.debug.targetIp}:~/",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "owner": "gcc",
                "source": "gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Get DuetControlServer PID",
            "type": "shell",
            "command": "python3 ${workspaceFolder}/scripts/internal/get_remote_dsf_pid.py",
            "problemMatcher": [],
            "options": {
                "env": {
                    "DSF_SSH_USER": "${config:dsf.debug.sshUser}",
                    "DSF_TARGET_IP": "${config:dsf.debug.targetIp}",
                    "WORKSPACE_FOLDER": "${workspaceFolder}"
                }
            }
        },
        {
            "label": "[DSF] Stop DSF Services",
            "type": "shell",
            "command": "ssh root@${config:dsf.debug.targetIp} 'systemctl stop duetcontrolserver duetwebserver duetpluginservice duetpluginservice-root'",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "[DSF] Restart DSF Services",
            "type": "shell",
            "command": "ssh root@${config:dsf.debug.targetIp} 'systemctl restart duetcontrolserver duetwebserver duetpluginservice duetpluginservice-root' && python3 ${workspaceFolder}/scripts/internal/get_remote_dsf_pid.py",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "options": {
                "env": {
                    "DSF_SSH_USER": "${config:dsf.debug.sshUser}",
                    "DSF_TARGET_IP": "${config:dsf.debug.targetIp}",
                    "WORKSPACE_FOLDER": "${workspaceFolder}"
                }
            }
        },
        {
            "label": "[DSF] Stop Remote DuetControlServer",
            "type": "shell",
            "command": "ssh ${config:dsf.debug.sshUser}@${config:dsf.debug.targetIp} 'systemctl stop duetcontrolserver'",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                // "reveal": "silent"
            }
        },
        {
            "label": "[DSF] Start Remote DuetControlServer",
            "type": "shell",
            "command": "ssh ${config:dsf.debug.sshUser}@${config:dsf.debug.targetIp} 'systemctl start duetcontrolserver'",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                // "reveal": "silent"
            }
        },
        {
            "label": "[DSF] Set Debug Target IP",
            "type": "shell",
            "command": "python3 scripts/internal/create_settings.py --target-ip ${input:debug_target_ip}",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        // ---------------------------------------------------------------
        // Firmware: DuetCANMaster, RepRapFirmware, Duet3Expansion, Duet3Bootloader and DuetIAP. Every
        // board is a preset in CMakePresets.json, built into build/<preset>/ (see scripts/build.py).
        // ---------------------------------------------------------------
        {
            "label": "[Firmware] Build Board",
            "type": "shell",
            // A shell, so that the empty Release build type adds no argument
            "command": "scripts/build.py ${input:firmware_board} ${input:firmware_build_type}",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": {
                "owner": "gcc",
                "source": "gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "group": "build"
        },
        {
            "label": "[Firmware] Build All Boards",
            "type": "shell",
            // A shell, so that the empty Release build type adds no argument
            "command": "scripts/build.py firmware --keep-going ${input:firmware_build_type}",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": {
                "owner": "gcc",
                "source": "gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "group": "build"
        },
        {
            "label": "[Firmware] Show Memory Use",
            "type": "process",
            "command": "python3",
            "args": ["scripts/size.py"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            // Run by "[Firmware] Build, Flash & Debug" for the board picked there. Configuring links the image to the
            // fixed names in the build tree's vscode directory that the launch configurations use
            "label": "[Firmware] Build Debug Firmware",
            "type": "shell",
            "command": "cmake --preset ${input:board}-debug && cmake --build --preset ${input:board}-debug",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": {
                "owner": "gcc",
                "source": "gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}/build/${input:board}-debug"],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "hide": true
        },
        {
            // Run by "[Firmware] Flash & Debug Bootloader" for the bootloader picked there
            "label": "[Firmware] Build & Flash Debug Bootloader",
            "type": "process",
            "command": "python3",
            "args": ["scripts/flash_bootloader.py", "${input:bootloader}", "--debug", "--build", "--server", "${input:gdbServer}"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": {
                "owner": "gcc",
                "source": "gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}/build/${input:bootloader}-debug"],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "hide": true
        },
        {
            // Run when a debug session ends, which leaves the board halted: reset it and let it run
            "label": "[Firmware] Restart Firmware",
            "type": "process",
            "command": "arm-none-eabi-gdb",
            "args": [
                // Run the commands below in order and exit, carrying on past any that fail
                "-batch",
                // Connect to the GDB server the debug session used, which halts the target
                "-ex", "target extended-remote ${input:gdbServer}",
                // Reset the MCU and let it run, with the commands for that GDB server
                "-ex", "source ${workspaceFolder}/.vscode/gdb/${input:gdbServerType}.gdb",
                "-ex", "duet-reset-run",
                // Disconnect, leaving the target running
                "-ex", "detach"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "silent" },
            "problemMatcher": [],
            "hide": true
        },
        {
            // Upload the built firmware to a standalone (no SBC) main board and update it and the boards connected
            // to it, as on the regression suite's rrf bench (see scripts/deploy.py)
            "label": "[Firmware] Deploy Release Firmware to Standalone Board",
            "type": "process",
            "command": "python3",
            "args": ["scripts/deploy.py", "-H", "${input:duetHost}", "firmware", "--password", "${input:duetPassword}"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "[Firmware] Deploy Debug Firmware to Standalone Board",
            "type": "process",
            "command": "python3",
            "args": ["scripts/deploy.py", "-H", "${input:duetHost}", "firmware", "--password", "${input:duetPassword}", "--debug"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            // Update the expansion boards' bootloaders over CAN through a main board (see scripts/deploy.py --bootloader)
            "label": "[Firmware] Deploy Bootloaders (CAN)",
            "type": "process",
            "command": "python3",
            "args": ["scripts/deploy.py", "-H", "${input:duetHost}", "firmware", "--password", "${input:duetPassword}", "--bootloader"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            // Flash a bootloader over SWD through OpenOCD's GDB server (see scripts/flash_bootloader.py)
            "label": "[Firmware] Flash Bootloader (SWD)",
            "type": "process",
            "command": "python3",
            "args": ["scripts/flash_bootloader.py", "${input:bootloaderPick}", "--server", "${input:gdbServerPrompt}", "--build"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "[Firmware] Clean All Boards",
            "type": "process",
            "command": "python3",
            "args": ["scripts/clean.py", "firmware", "--purge"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        // ---------------------------------------------------------------
        // Submodules
        // ---------------------------------------------------------------
        {
            // Pull each submodule's tracked branch (see .gitmodules) and merge it into the branch checked out there.
            // A submodule on a detached HEAD stays detached
            "label": "[Git] Update Submodules",
            "type": "process",
            "command": "python3",
            "args": ["scripts/submodule.py", "update"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            // Check out each submodule's tracked branch (see .gitmodules), so changes made there are committed to a branch
            "label": "[Git] Checkout Submodule Branches",
            "type": "process",
            "command": "python3",
            "args": ["scripts/submodule.py", "checkout"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            // Put each submodule on a branch whose tip is the commit it has checked out, preferring the tracked branch,
            // so its files are unchanged
            "label": "[Git] Attach Submodules to Branches",
            "type": "process",
            "command": "python3",
            "args": ["scripts/submodule.py", "attach"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            // Switch each submodule that has the given branch to it and fast-forward it from origin, which can change the
            // commit. The others are attached as above, and pulled too
            "label": "[Git] Pull Submodules to Branch",
            "type": "process",
            "command": "python3",
            "args": ["scripts/submodule.py", "attach", "--branch", "${input:submoduleBranch}", "--pull"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            // Check that each submodule committed in HEAD is on its tracked branch (see .gitmodules), and how far behind it is
            "label": "[Git] Check Submodules",
            "type": "process",
            "command": "python3",
            "args": ["scripts/submodule.py", "check"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "[Style] Format DuetCANMaster",
            "type": "shell",
            "command": "clang-format -i --style=file $(find src -name '*.cpp' -o -name '*.h' | grep -vE '^src/(libc|libcpp)/')",
            "options": {
                "cwd": "${workspaceFolder}/src/DuetCANMaster"
            },
            "problemMatcher": [],
            "group": "build",
            "detail": "Reformat first-party sources. Skips src/libc and src/libcpp (vendored newlib/GCC runtime)."
        },
        {
            "label": "[Style] Format DuetRealtimeCore",
            "type": "shell",
            "command": "clang-format -i --style=file $(find src harness tests -name '*.cpp' -o -name '*.h')",
            "options": {
                "cwd": "${workspaceFolder}/src/DuetRealtimeCore"
            },
            "problemMatcher": [],
            "group": "build",
            "detail": "Reformat sbc/, harness/ and tests/."
        },
        {
            "label": "[Style] Check Formatting (both projects)",
            "type": "shell",
            "command": "cd ${workspaceFolder}/src/DuetCANMaster && clang-format --dry-run --Werror --style=file $(find src -name '*.cpp' -o -name '*.h' | grep -vE '^src/(libc|libcpp)/') && cd ${workspaceFolder}/src/DuetRealtimeCore && clang-format --dry-run --Werror --style=file $(find src harness tests -name '*.cpp' -o -name '*.h') && echo 'Formatting OK'",
            "problemMatcher": {
                "owner": "gcc",
                "source": "gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "group": "test",
            "detail": "Non-mutating check; exits non-zero if anything would be reformatted. Suitable for CI."
        },
        {
            // CMake writes the database at configure time, so this compiles nothing and takes
            // about a second. Hence Tidy below just depends on it.
            "label": "[Style] Generate Compile DB - Firmware Board",
            "type": "process",
            "command": "python3",
            "args": ["scripts/lint.py", "${input:firmware_board}", "--database-only"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            },
            "runOptions": {
                "instanceLimit": 1
            },
            "group": "build",
            "detail": "Configure the board's preset, keep the C++ TUs the build lints (not third-party code), and rewrite them so clang can parse the bare-metal ARM flags. Writes build/<board>/clang-tidy/compile_commands.json."
        },
        {
            // The database is regenerated first so it always matches the board picked here; it is
            // a CMake configure, not a build, so this costs about a second.
            "label": "[Style] Tidy Firmware Board",
            "type": "shell",
            "command": "scripts/lint.py ${input:firmware_board}",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": {
                "owner": "gcc",
                "source": "gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "group": "test",
            "detail": "Regenerates the compile DB for the chosen board, then lints every project and library it builds. Report only. Do not add -fix: per-file fixing corrupts shared headers; see scripts/export_naming_fixes.py."
        },
        {
            "label": "[Style] Tidy DuetRealtimeCore",
            "type": "shell",
            "command": "scripts/lint.py DuetRealtimeCore",
            "problemMatcher": {
                "owner": "gcc",
                "source": "gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "group": "test",
            "detail": "Report only. Do not add -fix: per-file fixing corrupts shared headers."
        }
    ]
}