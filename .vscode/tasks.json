{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "ip_address",
            "type": "promptString",
            "description": "IP address of SBC to deploy to"
        },
        {
            "id": "debug_target_ip",
            "type": "promptString",
            "description": "IP address of debug target SBC (saved to .vscode/settings.json)"
        },
        {
            "id": "ssh_user",
            "type": "promptString",
            "description": "SSH user for remote target",
            "default": "root"
        },
        {
            "id": "project_name",
            "type": "pickString",
            "description": "Project name to build",
            "options": [
                "All",
                "DuetControlServer",
                "DuetRealtimeCore",
                "DuetPiManagementPlugin",
                "DuetPluginService",
                "DuetWebServer",
                "PluginManager",
                "CodeConsole",
                "CodeLogger",
                "CodeStream",
                "CustomHttpEndpoint",
                "ModelObserver"
            ]
        },
        {
            "id": "dotnet_aot",
            "type": "pickString",
            "description": "Build DuetControlServer using native AOT compilation",
            "options": [
                "Yes",
                "No"
            ]
        },
        {
            // The boards are the CMake presets; the pick is remembered for "[Firmware] Build Debug Firmware",
            // which the firmware launch configurations run
            "id": "firmware_board",
            "type": "command",
            "command": "extension.commandvariable.pickStringRemember",
            "args": {
                "description": "Firmware board to build",
                "key": "board",
                "addLabelToTop": "${remember:board}",
                "fileName": "${workspaceFolder}/CMakePresets.json",
                "fileFormat": "json",
                "jsonOption": {
                    "label": "content.configurePresets.filter(p => !p.hidden && !p.name.endsWith('-debug'))[__itemIdx__].name",
                    "description": "content.configurePresets.filter(p => !p.hidden && !p.name.endsWith('-debug'))[__itemIdx__].displayName",
                    "value": "content.configurePresets.filter(p => !p.hidden && !p.name.endsWith('-debug'))[__itemIdx__].name"
                }
            }
        },
        {
            "id": "firmware_build_type",
            "type": "pickString",
            "description": "Firmware build type",
            "options": [
                { "label": "Release", "value": "" },
                { "label": "Debug", "value": "--debug" }
            ],
            "default": ""
        },
        {
            "id": "board",
            "type": "command",
            "command": "extension.commandvariable.remember",
            "args": { "key": "board" }
        },
        {
            "id": "gdbServer",
            "type": "command",
            "command": "extension.commandvariable.remember",
            "args": { "key": "gdbServer" }
        },
        {
            "id": "duetHost",
            "type": "command",
            "command": "extension.commandvariable.promptStringRemember",
            "args": {
                "key": "duetHost",
                "description": "Main board host name or IP address",
                "default": "duet3.local"
            }
        },
        {
            "id": "duetPassword",
            "type": "promptString",
            "description": "Main board password (reprap if none is set)",
            "password": true,
            "default": "reprap"
        }
    ],
    "tasks": [
        {
            "label": "[DSF] Clean Build Directory",
            "command": "rm -rf build",
            "type": "shell",
            "args": [],
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Make Build Directory",
            "command": "mkdir -p build",
            "type": "shell",
            "args": [],
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "[DSF] Restore DSF Solution",
            "type": "shell",
            "command": "dotnet restore ./src/DuetSoftwareFramework.sln -r linux-arm64",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Build CodeConsole",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/CodeConsole -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "[DSF] Make Build Directory",
        },
        {
            "label": "[DSF] Build CodeLogger",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/CodeLogger -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "[DSF] Make Build Directory",
        },
        {
            "label": "[DSF] Build CodeStream",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/CodeStream -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "[DSF] Make Build Directory",
        },
        {
            "label": "[DSF] Build CustomHttpEndpoint",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/CustomHttpEndpoint -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "[DSF] Make Build Directory",
        },
        {
            "label": "[DSF] Build DuetControlServer",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/DuetControlServer -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            // DCS P/Invokes into libduet_realtime_core.so and will not start without it
            "dependsOn": [
                "[DSF] Make Build Directory",
                "[DSF] Build DuetRealtimeCore"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "[DSF] Build DuetPiManagementPlugin",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/DuetPiManagementPlugin -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "[DSF] Make Build Directory",
        },
        {
            "label": "[DSF] Build DuetPluginService",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/DuetPluginService -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "[DSF] Make Build Directory",
        },
        {
            "label": "[DSF] Build DuetWebServer",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/DuetWebServer -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "[DSF] Make Build Directory",
        },
        {
            "label": "[DSF] Build ModelObserver",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/ModelObserver -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "[DSF] Make Build Directory",
        },
        {
            "label": "[DSF] Build PluginManager",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/PluginManager -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "[DSF] Make Build Directory",
        },
        {
            "label": "[DSF] Build All",
            "type": "shell",
            "command": "echo Build Complete",
            "args": [],
            "problemMatcher": [],
            "dependsOn": [
                "[DSF] Build CodeConsole",
                "[DSF] Build CodeLogger",
                "[DSF] Build CodeStream",
                "[DSF] Build CustomHttpEndpoint",
                "[DSF] Build DuetRealtimeCore",
                "[DSF] Build DuetControlServer",
                "[DSF] Build DuetPiManagementPlugin",
                "[DSF] Build DuetPluginService",
                "[DSF] Build DuetWebServer",
                "[DSF] Build ModelObserver",
                "[DSF] Build PluginManager"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOrder": "sequence"
        },
        {
            "label": "[DSF] Restore & Build All",
            "type": "shell",
            "command": "echo Build Complete",
            "args": [],
            "problemMatcher": [],
            "dependsOn": [
                "[DSF] Restore DSF Solution",
                "[DSF] Build All",
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOrder": "sequence"
        },
        {
            "label": "[DSF] Install vsdbg on Remote",
            "type": "shell",
            "command": "ssh -o StrictHostKeyChecking=no ${config:dsf.debug.sshUser}@${config:dsf.debug.targetIp} 'mkdir -p ~/vsdbg && curl -fsSL https://aka.ms/getvsdbgsh | bash /dev/stdin -v latest -l ~/vsdbg && ~/vsdbg/vsdbg --version'",
            "problemMatcher": []
        },
        {
            "label": "[DSF] Deploy To",
            "type": "shell",
            "command": "scripts/build_dsf.py $([ '${input:dotnet_aot}' = 'Yes' ] && echo --aot) --skip-build --target ${config:dsf.debug.targetIp} --user ${config:dsf.debug.sshUser} --start-services ${input:project_name}",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Deploy Local",
            "type": "shell",
            "command": "scripts/build_dsf.py $([ '${input:dotnet_aot}' = 'Yes' ] && echo --aot) --skip-build --local ${input:project_name}",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Build",
            "type": "shell",
            "command": "scripts/build_dsf.py $([ '${input:dotnet_aot}' = 'Yes' ] && echo --aot) ${input:project_name}",
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Build and Deploy To",
            "type": "shell",
            "command": "scripts/build_dsf.py $([ '${input:dotnet_aot}' = 'Yes' ] && echo --aot) --target ${config:dsf.debug.targetIp} --user ${config:dsf.debug.sshUser} --start-services ${input:project_name} && python3 ${workspaceFolder}/.vscode/scripts/get_remote_dsf_pid.py",
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "options": {
                "env": {
                    "DSF_SSH_USER": "${config:dsf.debug.sshUser}",
                    "DSF_TARGET_IP": "${config:dsf.debug.targetIp}",
                    "WORKSPACE_FOLDER": "${workspaceFolder}"
                }
            }
        },
        {
            "label": "[DSF] Build and Deploy Local",
            "type": "shell",
            "command": "scripts/build_dsf.py $([ '${input:dotnet_aot}' = 'Yes' ] && echo --aot) --local ${input:project_name}",
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Build and Deploy DCS to",
            "type": "shell",
            "command": "scripts/build_dsf.py $([ '${input:dotnet_aot}' = 'Yes' ] && echo --aot) --target ${config:dsf.debug.targetIp} --user ${config:dsf.debug.sshUser} --start-services DuetControlServer && python3 ${workspaceFolder}/.vscode/scripts/get_remote_dsf_pid.py",
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "options": {
                "env": {
                    "DSF_SSH_USER": "${config:dsf.debug.sshUser}",
                    "DSF_TARGET_IP": "${config:dsf.debug.targetIp}",
                    "WORKSPACE_FOLDER": "${workspaceFolder}"
                }
            }
        },
        {
            // Native SPI transfer loop (libduet_realtime_core.so). Cross-compiled for aarch64. The
            // devcontainer's glibc matches Raspberry Pi OS Bookworm's, so no sysroot is involved.
            "label": "[DSF] Build DuetRealtimeCore",
            "type": "shell",
            "command": "scripts/build_dsf.py DuetRealtimeCore",
            "problemMatcher": [
                "$gcc"
            ],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Build and Deploy DuetRealtimeCore to",
            "type": "shell",
            "command": "scripts/build_dsf.py --target ${config:dsf.debug.targetIp} --user ${config:dsf.debug.sshUser} --start-services DuetRealtimeCore",
            "problemMatcher": [
                "$gcc"
            ],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            // Fetch a sysroot from the Pi. Not needed for Bookworm targets; only for cross-building
            // against a glibc older than the container's 2.36.
            "label": "[DSF] Fetch Pi Sysroot",
            "type": "shell",
            "command": "./src/DuetRealtimeCore/scripts/fetch-pi-sysroot.sh ${config:dsf.debug.sshUser}@${config:dsf.debug.targetIp} ./src/DuetRealtimeCore/pi-sysroot",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            // The C# test suite (DCS, DuetAPI, DuetHttpClient). Runs natively for the host.
            "label": "[DSF] Run C# Unit Tests",
            "type": "shell",
            "command": "dotnet test ./src/UnitTests/UnitTests.csproj --nologo",
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "test",
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            // The C# test suite. Runs DCS & DuetRealtimeCore natively for the host.
            "label": "[DSF] Run C# System Tests",
            "type": "shell",
            "command": "dotnet test ./src/SystemTests/SystemTests.csproj --nologo",
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "test",
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            // Host-side unit tests for the native interface (ring buffer framing/concurrency).
            // Builds natively for the host, so no Pi or sysroot is involved.
            "label": "[DSF] Run Native Tests",
            "type": "shell",
            "command": "cmake --preset native && cmake --build --preset native -j && ctest --test-dir build/native --output-on-failure",
            "options": {
                "cwd": "${workspaceFolder}/src/DuetRealtimeCore"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "test",
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            // Builds and deploys the jitter harness, which measures RequestTransfer -> transfer
            // latency without the .NET runtime. Statically linked, so it needs no sysroot.
            "label": "[DSF] Build and Deploy Jitter Harness to",
            "type": "shell",
            "command": "cmake --preset arm64 && cmake --build --preset arm64 --target realtime_core_jitter_test -j && scp build/arm64/harness/realtime_core_jitter_test ${config:dsf.debug.sshUser}@${config:dsf.debug.targetIp}:~/",
            "options": {
                "cwd": "${workspaceFolder}/src/DuetRealtimeCore"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Get DuetControlServer PID",
            "type": "shell",
            "command": "python3 ${workspaceFolder}/.vscode/scripts/get_remote_dsf_pid.py",
            "problemMatcher": [],
            "options": {
                "env": {
                    "DSF_SSH_USER": "${config:dsf.debug.sshUser}",
                    "DSF_TARGET_IP": "${config:dsf.debug.targetIp}",
                    "WORKSPACE_FOLDER": "${workspaceFolder}"
                }
            }
        },
        {
            "label": "[DSF] Stop DSF Services",
            "type": "shell",
            "command": "ssh root@${config:dsf.debug.targetIp} 'systemctl stop duetcontrolserver duetwebserver duetpluginservice duetpluginservice-root'",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "[DSF] Restart DSF Services",
            "type": "shell",
            "command": "ssh root@${config:dsf.debug.targetIp} 'systemctl restart duetcontrolserver duetwebserver duetpluginservice duetpluginservice-root' && python3 ${workspaceFolder}/.vscode/scripts/get_remote_dsf_pid.py",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "options": {
                "env": {
                    "DSF_SSH_USER": "${config:dsf.debug.sshUser}",
                    "DSF_TARGET_IP": "${config:dsf.debug.targetIp}",
                    "WORKSPACE_FOLDER": "${workspaceFolder}"
                }
            }
        },
        {
            "label": "[DSF] Stop Remote DuetControlServer",
            "type": "shell",
            "command": "ssh ${config:dsf.debug.sshUser}@${config:dsf.debug.targetIp} 'systemctl stop duetcontrolserver'",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                // "reveal": "silent"
            }
        },
        {
            "label": "[DSF] Start Remote DuetControlServer",
            "type": "shell",
            "command": "ssh ${config:dsf.debug.sshUser}@${config:dsf.debug.targetIp} 'systemctl start duetcontrolserver'",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                // "reveal": "silent"
            }
        },
        {
            "label": "[DSF] Set Debug Target IP",
            "type": "shell",
            "command": "python3 scripts/create_settings.py --target-ip ${input:debug_target_ip}",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        // ---------------------------------------------------------------
        // Firmware: DuetCANMaster, RepRapFirmware, Duet3Expansion, Duet3Bootloader and DuetIAP. Every
        // board is a preset in CMakePresets.json, built into build/<preset>/ (see scripts/build.py).
        // ---------------------------------------------------------------
        {
            "label": "[Firmware] Build Board",
            "type": "shell",
            // A shell, so that the empty Release build type adds no argument
            "command": "python3 scripts/build.py ${input:firmware_board} ${input:firmware_build_type}",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"]
            },
            "group": "build"
        },
        {
            "label": "[Firmware] Build All Boards",
            "type": "shell",
            // A shell, so that the empty Release build type adds no argument
            "command": "python3 scripts/build.py --all --keep-going ${input:firmware_build_type}",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"]
            },
            "group": "build"
        },
        {
            "label": "[Firmware] Show Memory Use",
            "type": "process",
            "command": "python3",
            "args": ["scripts/size.py"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            // Run by "[Firmware] Build, Flash & Debug" for the board picked there. Configuring links the image to the
            // fixed names in the build tree's vscode directory that the launch configurations use
            "label": "[Firmware] Build Debug Firmware",
            "type": "shell",
            "command": "cmake --preset ${input:board}-debug && cmake --build --preset ${input:board}-debug",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}/build/${input:board}-debug"]
            },
            "hide": true
        },
        {
            // Run when a debug session ends, which leaves the board halted: reset it and let it run
            "label": "[Firmware] Restart Firmware",
            "type": "process",
            "command": "arm-none-eabi-gdb",
            "args": [
                // Run the commands below in order and exit, carrying on past any that fail
                "-batch",
                // Connect to the GDB server the debug session used, which halts the target
                "-ex", "target extended-remote ${input:gdbServer}",
                // Reset the MCU; J-Link leaves it halted afterwards, OpenOCD lets it run
                "-ex", "monitor reset",
                // Let it run on J-Link and pyOCD; OpenOCD rejects this
                "-ex", "monitor go",
                // Let it run on OpenOCD; J-Link rejects this
                "-ex", "monitor resume",
                // Disconnect, leaving the target running
                "-ex", "detach"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "silent" },
            "problemMatcher": [],
            "hide": true
        },
        {
            // Upload the built firmware to a standalone (no SBC) main board and update it and the boards connected
            // to it, as on the regression suite's rrf bench (see scripts/deploy.py)
            "label": "[Firmware] Deploy Release Firmware to Standalone Board",
            "type": "process",
            "command": "python3",
            "args": ["scripts/deploy.py", "${input:duetHost}", "--password", "${input:duetPassword}"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "[Firmware] Deploy Debug Firmware to Standalone Board",
            "type": "process",
            "command": "python3",
            "args": ["scripts/deploy.py", "${input:duetHost}", "--password", "${input:duetPassword}", "--debug"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "[Firmware] Clean All Boards",
            "type": "process",
            "command": "python3",
            "args": ["scripts/clean.py", "--all", "--purge"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        // ---------------------------------------------------------------
        // Submodules
        // ---------------------------------------------------------------
        {
            // Pull each submodule's tracked branch (see .gitmodules) and merge it into the branch checked out there.
            // A submodule on a detached HEAD stays detached
            "label": "[Git] Update Submodules",
            "type": "process",
            "command": "git",
            "args": ["submodule", "update", "--remote", "--merge"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            // Check out each submodule's tracked branch (see .gitmodules), so changes made there are committed to a branch
            "label": "[Git] Checkout Submodule Branches",
            "type": "process",
            "command": "git",
            "args": ["submodule", "foreach", "git switch $(git config -f $toplevel/.gitmodules submodule.$name.branch)"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            // Check that each submodule committed in HEAD is on its tracked branch (see .gitmodules), and how far behind it is
            "label": "[Git] Check Submodules",
            "type": "process",
            "command": "python3",
            "args": ["scripts/check_submodules.py"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "[Style] Format DuetCANMaster",
            "type": "shell",
            "command": "clang-format -i --style=file $(find src -name '*.cpp' -o -name '*.h' | grep -vE '^src/(libc|libcpp)/')",
            "options": {
                "cwd": "${workspaceFolder}/src/DuetCANMaster"
            },
            "problemMatcher": [],
            "group": "build",
            "detail": "Reformat first-party sources. Skips src/libc and src/libcpp (vendored newlib/GCC runtime)."
        },
        {
            "label": "[Style] Format DuetRealtimeCore",
            "type": "shell",
            "command": "clang-format -i --style=file $(find src harness tests -name '*.cpp' -o -name '*.h')",
            "options": {
                "cwd": "${workspaceFolder}/src/DuetRealtimeCore"
            },
            "problemMatcher": [],
            "group": "build",
            "detail": "Reformat sbc/, harness/ and tests/."
        },
        {
            "label": "[Style] Check Formatting (both projects)",
            "type": "shell",
            "command": "cd ${workspaceFolder}/src/DuetCANMaster && clang-format --dry-run --Werror --style=file $(find src -name '*.cpp' -o -name '*.h' | grep -vE '^src/(libc|libcpp)/') && cd ${workspaceFolder}/src/DuetRealtimeCore && clang-format --dry-run --Werror --style=file $(find src harness tests -name '*.cpp' -o -name '*.h') && echo 'Formatting OK'",
            "problemMatcher": [
                "$gcc"
            ],
            "group": "test",
            "detail": "Non-mutating check; exits non-zero if anything would be reformatted. Suitable for CI."
        },
        {
            // CMake writes the database at configure time, so this compiles nothing and takes
            // about a second. Hence Tidy below just depends on it.
            "label": "[Style] Generate Compile DB - Firmware Board",
            "type": "process",
            "command": "python3",
            "args": ["scripts/gen_compile_commands.py", "${input:firmware_board}"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            },
            "runOptions": {
                "instanceLimit": 1
            },
            "group": "build",
            "detail": "Configure the board's preset, keep the C++ TUs the build lints (not third-party code), and rewrite them so clang can parse the bare-metal ARM flags. Writes build/<board>/clang-tidy/compile_commands.json."
        },
        {
            "label": "[Style] Generate Compile DB - DuetRealtimeCore",
            "type": "shell",
            "command": "cmake -S . -B build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
            "options": {
                "cwd": "${workspaceFolder}/src/DuetRealtimeCore"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "CMake exports compile_commands.json into build/."
        },
        {
            // The database is regenerated first so it always matches the board picked here; it is
            // a CMake configure, not a build, so this costs about a second.
            "label": "[Style] Tidy Firmware Board",
            "type": "shell",
            "command": "python3 scripts/gen_compile_commands.py ${input:firmware_board} && run-clang-tidy -p build/${input:firmware_board}/clang-tidy -j $(nproc) -quiet 2>&1 | python3 scripts/tidy_report.py",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "test",
            "detail": "Regenerates the compile DB for the chosen board, then lints every project and library it builds. Report only. Do not add -fix: per-file fixing corrupts shared headers; see scripts/export_naming_fixes.py."
        },
        {
            "label": "[Style] Tidy DuetRealtimeCore",
            "type": "shell",
            "command": "test -f build/compile_commands.json || { echo 'No build/compile_commands.json - run [Style] Generate Compile DB - DuetRealtimeCore first' >&2; exit 1; }; run-clang-tidy -p build -j $(nproc) -quiet '^.*/src/DuetRealtimeCore/(src|harness|tests)/.*\\.cpp$' 2>&1 | python3 ${workspaceFolder}/scripts/tidy_report.py",
            "options": {
                "cwd": "${workspaceFolder}/src/DuetRealtimeCore"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "test",
            "detail": "Report only. Do not add -fix: per-file fixing corrupts shared headers."
        }
    ]
}