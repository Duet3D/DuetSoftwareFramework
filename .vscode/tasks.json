{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "ip_address",
            "type": "promptString",
            "description": "IP address of SBC to deploy to"
        },
        {
            "id": "debug_target_ip",
            "type": "promptString",
            "description": "IP address of debug target SBC (saved to .vscode/settings.json)"
        },
        {
            "id": "ssh_user",
            "type": "promptString",
            "description": "SSH user for remote target",
            "default": "root"
        },
        {
            "id": "project_name",
            "type": "pickString",
            "description": "Project name to build",
            "options": [
                "All",
                "DuetControlServer",
                "DuetPiManagementPlugin",
                "DuetPluginService",
                "DuetWebServer",
                "PluginManager",
                "CodeConsole",
                "CodeLogger",
                "CodeStream",
                "CustomHttpEndpoint",
                "ModelObserver"
            ]
        }
    ],
    "tasks": [
        {
            "label": "Clean Build Directory",
            "command": "rm -rf build",
            "type": "shell",
            "args": [],
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "Make Build Directory",
            "command": "mkdir -p build",
            "type": "shell",
            "args": [],
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Restore DSF Solution",
            "type": "shell",
            "command": "dotnet restore ./src/DuetSoftwareFramework.sln -r linux-arm64",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "Build CodeConsole",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/CodeConsole -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "Make Build Directory",
        },
        {
            "label": "Build CodeLogger",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/CodeLogger -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "Make Build Directory",
        },
        {
            "label": "Build CodeStream",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/CodeStream -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "Make Build Directory",
        },
        {
            "label": "Build CustomHttpEndpoint",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/CustomHttpEndpoint -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "Make Build Directory",
        },
        {
            "label": "Build DuetControlServer",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/DuetControlServer -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "Make Build Directory",
        },
        {
            "label": "Build DuetPiManagementPlugin",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/DuetPiManagementPlugin -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "Make Build Directory",
        },
        {
            "label": "Build DuetPluginService",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/DuetPluginService -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "Make Build Directory",
        },
        {
            "label": "Build DuetWebServer",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/DuetWebServer -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "Make Build Directory",
        },
        {
            "label": "Build ModelObserver",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/ModelObserver -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "Make Build Directory",
        },
        {
            "label": "Build PluginManager",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/PluginManager -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "Make Build Directory",
        },
        {
            "label": "Build All",
            "type": "shell",
            "command": "echo Build Complete",
            "args": [],
            "problemMatcher": [],
            "dependsOn": [
                "Build CodeConsole",
                "Build CodeLogger",
                "Build CodeStream",
                "Build CustomHttpEndpoint",
                "Build DuetControlServer",
                "Build DuetPiManagementPlugin",
                "Build DuetPluginService",
                "Build DuetWebServer",
                "Build ModelObserver",
                "Build PluginManager"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOrder": "sequence"
        },
        {
            "label": "Restore & Build All",
            "type": "shell",
            "command": "echo Build Complete",
            "args": [],
            "problemMatcher": [],
            "dependsOn": [
                "Restore DSF Solution",
                "Build All",
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOrder": "sequence"
        },
        {
            "label": "Install vsdbg on Remote",
            "type": "shell",
            "command": "ssh -o StrictHostKeyChecking=no ${config:dsf.debug.sshUser}@${config:dsf.debug.targetIp} 'mkdir -p ~/vsdbg && curl -fsSL https://aka.ms/getvsdbgsh | bash /dev/stdin -v latest -l ~/vsdbg && ~/vsdbg/vsdbg --version'",
            "problemMatcher": []
        },
        {
            "label": "Deploy To",
            "type": "shell",
            "command": "./scripts/deploy.sh --skip-build --target ${config:dsf.debug.targetIp} --user ${config:dsf.debug.sshUser} ${input:project_name}",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "Deploy Local",
            "type": "shell",
            "command": "./scripts/deploy.sh --skip-build --local ${input:project_name}",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "Build and Deploy To",
            "type": "shell",
            "command": "./scripts/deploy.sh --target ${config:dsf.debug.targetIp} --user ${config:dsf.debug.sshUser} ${input:project_name}",
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "Build and Deploy Local",
            "type": "shell",
            "command": "./scripts/deploy.sh --local ${input:project_name}",
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "Build and Deploy DCS to",
            "type": "shell",
            "command": "./scripts/deploy.sh --target ${config:dsf.debug.targetIp} --user ${config:dsf.debug.sshUser} DuetControlServer",
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "Stop DSF Services",
            "type": "shell",
            "command": "ssh root@${config:dsf.debug.targetIp} 'systemctl stop duetcontrolserver duetwebserver duetpluginservice duetpluginservice-root'",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Restart DSF Services",
            "type": "shell",
            "command": "ssh root@${config:dsf.debug.targetIp} 'systemctl restart duetcontrolserver duetwebserver duetpluginservice duetpluginservice-root'",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "Stop Remote DuetControlServer",
            "type": "shell",
            "command": "ssh ${config:config:dsf.debug.sshUser}@${config:dsf.debug.targetIp} 'systemctl stop duetcontrolserver'",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Start Remote DuetControlServer",
            "type": "shell",
            "command": "ssh ${config:config:dsf.debug.sshUser}@${config:dsf.debug.targetIp} 'systemctl start duetcontrolserver'",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Set Debug Target IP",
            "type": "shell",
            "command": "python3 scripts/create_settings.py --target-ip ${input:debug_target_ip}",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}