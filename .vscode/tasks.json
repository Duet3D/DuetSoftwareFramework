{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "ip_address",
            "type": "promptString",
            "description": "IP address of SBC to deploy to"
        },
        {
            "id": "ssh_user",
            "type": "promptString",
            "description": "SSH user for remote target",
            "default": "root"
        }
    ],
    "tasks": [
        {
            "label": "Clean Build Directory",
            "command": "rm -rf build",
            "type": "shell",
            "args": [],
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "Make Build Directory",
            "command": "mkdir -p build",
            "type": "shell",
            "args": [],
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Restore DSF Solution",
            "type": "shell",
            "command": "dotnet restore ./src/DuetSoftwareFramework.sln -r linux-arm64",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "Build CodeConsole",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/CodeConsole -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "Make Build Directory",
        },
        {
            "label": "Build CodeLogger",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/CodeLogger -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "Make Build Directory",
        },
        {
            "label": "Build CodeStream",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/CodeStream -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "Make Build Directory",
        },
        {
            "label": "Build CustomHttpEndpoint",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/CustomHttpEndpoint -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "Make Build Directory",
        },
        {
            "label": "Build DuetControlServer",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/DuetControlServer -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "Make Build Directory",
        },
        {
            "label": "Build DuetPiManagementPlugin",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/DuetPiManagementPlugin -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "Make Build Directory",
        },
        {
            "label": "Build DuetPluginService",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/DuetPluginService -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "Make Build Directory",
        },
        {
            "label": "Build DuetWebServer",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/DuetWebServer -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "Make Build Directory",
        },
        {
            "label": "Build ModelObserver",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/ModelObserver -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "Make Build Directory",
        },
        {
            "label": "Build PluginManager",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/PluginManager -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "Make Build Directory",
        },
        {
            "label": "Build All",
            "type": "shell",
            "command": "echo Build Complete",
            "args": [],
            "problemMatcher": [],
            "dependsOn": [
                "Restore DSF Solution",
                "Build CodeConsole",
                "Build CodeLogger",
                "Build CodeStream",
                "Build CustomHttpEndpoint",
                "Build DuetControlServer",
                "Build DuetPiManagementPlugin",
                "Build DuetPluginService",
                "Build DuetWebServer",
                "Build ModelObserver",
                "Build PluginManager"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOrder": "sequence"
        },
        {
            "label": "Install vsdbg on Remote",
            "type": "shell",
            "command": "ssh -o StrictHostKeyChecking=no ${input:ssh_user}@${input:ip_address} 'mkdir -p ~/vsdbg && curl -fsSL https://aka.ms/getvsdbgsh | bash /dev/stdin -v latest -l ~/vsdbg && ~/vsdbg/vsdbg --version'",
            "problemMatcher": []
        },
        {
            "label": "Deploy To",
            "type": "shell",
            "command": "rsync -rav --delete ./build/ root@${input:ip_address}:/opt/dsf/bin/ && ssh root@${input:ip_address} 'setcap cap_sys_ptrace,cap_dac_read_search,cap_sys_time+ep /opt/dsf/bin/DuetControlServer || true; setcap cap_net_bind_service+ep /opt/dsf/bin/DuetWebServer || true; systemctl start duetcontrolserver duetwebserver duetpluginservice duetpluginservice-root'",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": [
                "Stop DSF Services"
            ],
        },
        {
            "label": "Deploy Local",
            "type": "shell",
            "command": "sudo systemctl stop duetcontrolserver duetwebserver duetpluginservice duetpluginservice-root && sudo rsync -rav --delete ./build/ /opt/dsf/bin/ && (sudo setcap cap_sys_ptrace,cap_dac_read_search,cap_sys_time+ep /opt/dsf/bin/DuetControlServer || true) && (sudo setcap cap_net_bind_service+ep /opt/dsf/bin/DuetWebServer || true) && sudo systemctl start duetcontrolserver duetwebserver duetpluginservice duetpluginservice-root",
            "problemMatcher": [],
            "runOptions": {
            "instanceLimit": 1
            }
        },
        {
            "label": "Build and Deploy To",
            "type": "shell",
            "command": "echo Build and Deploy Complete",
            "args": [],
            "problemMatcher": [],
            "dependsOn": [
                "Build All",
                "Deploy To"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOrder": "sequence"
        },
        {
            "label": "Build and Deploy Local",
            "type": "shell",
            "command": "echo Build and Deploy Complete",
            "args": [],
            "problemMatcher": [],
            "dependsOn": [
                "Build All",
                "Deploy Local"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOrder": "sequence"
        },
        {
            "label": "Stop DSF Services",
            "type": "shell",
            "command": "ssh root@${input:ip_address} 'systemctl stop duetcontrolserver duetwebserver duetpluginservice duetpluginservice-root'",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Restart DSF Services",
            "type": "shell",
            "command": "ssh root@${input:ip_address} 'systemctl restart duetcontrolserver duetwebserver duetpluginservice duetpluginservice-root'",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            }
        }
    ]
}