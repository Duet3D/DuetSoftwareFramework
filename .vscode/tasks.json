{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "canmaster_board",
            "type": "pickString",
            "description": "DuetCANMaster board target to build the compile database for",
            "options": [ "Duet3_MB6HC", "Duet3_MB6XD" ],
            "default": "Duet3_MB6HC"
        },
        {
            "id": "ip_address",
            "type": "promptString",
            "description": "IP address of SBC to deploy to"
        },
        {
            "id": "debug_target_ip",
            "type": "promptString",
            "description": "IP address of debug target SBC (saved to .vscode/settings.json)"
        },
        {
            "id": "ssh_user",
            "type": "promptString",
            "description": "SSH user for remote target",
            "default": "root"
        },
        {
            "id": "project_name",
            "type": "pickString",
            "description": "Project name to build",
            "options": [
                "All",
                "DuetControlServer",
                "DuetSbcInterface",
                "DuetPiManagementPlugin",
                "DuetPluginService",
                "DuetWebServer",
                "PluginManager",
                "CodeConsole",
                "CodeLogger",
                "CodeStream",
                "CustomHttpEndpoint",
                "ModelObserver"
            ]
        },
        {
            "id": "canmaster_target",
            "type": "pickString",
            "description": "DuetCANMaster board to build for",
            "options": [
                {
                    "label": "Duet3 MB6HC",
                    "value": "Duet3_MB6HC"
                },
                {
                    "label": "Duet3 MB6XD",
                    "value": "Duet3_MB6XD"
                },
                {
                    "label": "Duet3 Mini 5+",
                    "value": "Duet3Mini5plus"
                },
                {
                    "label": "All",
                    "value": "all"
                }
            ]
        },
        {
            "id": "expansion_target",
            "type": "pickString",
            "description": "Duet3Expansion board to build for",
            "options": [
                { "label": "EXP3HC", "value": "EXP3HC" },
                { "label": "EXP1XD", "value": "EXP1XD" },
                { "label": "EXP1HCL", "value": "EXP1HCL" },
                { "label": "TOOL1LC", "value": "TOOL1LC" },
                { "label": "SAMMYC21", "value": "SAMMYC21" },
                { "label": "SZP", "value": "SZP" },
                { "label": "M23CL", "value": "M23CL" },
                { "label": "F3PTB", "value": "F3PTB" },
                { "label": "TOOL1RR", "value": "TOOL1RR" },
                { "label": "TOOLINDX", "value": "TOOLINDX" },
                { "label": "All", "value": "all" }
            ]
        },
        {
            "id": "fw_buildType",
            "type": "pickString",
            "description": "Firmware build type",
            "options": [
                {
                    "label": "Debug",
                    "value": "DEBUG=1"
                },
                {
                    "label": "Release",
                    "value": ""
                }
            ]
        },
        {
            "id": "duetHost",
            "type": "promptString",
            "description": "Duet host or IP",
            "default": "duet3.local"
        },
        {
            "id": "duetPassword",
            "type": "promptString",
            "description": "Duet HTTP password (leave empty if disabled)",
            "password": true,
            "default": ""
        }
    ],
    "tasks": [
        {
            "label": "[DSF] Clean Build Directory",
            "command": "rm -rf build",
            "type": "shell",
            "args": [],
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Make Build Directory",
            "command": "mkdir -p build",
            "type": "shell",
            "args": [],
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "[DSF] Restore DSF Solution",
            "type": "shell",
            "command": "dotnet restore ./src/DuetSoftwareFramework.sln -r linux-arm64",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Build CodeConsole",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/CodeConsole -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "[DSF] Make Build Directory",
        },
        {
            "label": "[DSF] Build CodeLogger",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/CodeLogger -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "[DSF] Make Build Directory",
        },
        {
            "label": "[DSF] Build CodeStream",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/CodeStream -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "[DSF] Make Build Directory",
        },
        {
            "label": "[DSF] Build CustomHttpEndpoint",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/CustomHttpEndpoint -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "[DSF] Make Build Directory",
        },
        {
            "label": "[DSF] Build DuetControlServer",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/DuetControlServer -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            // DCS P/Invokes into libduet_sbc.so and will not start without it
            "dependsOn": [
                "[DSF] Make Build Directory",
                "[DSF] Build DuetSbcInterface"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "[DSF] Build DuetPiManagementPlugin",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/DuetPiManagementPlugin -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "[DSF] Make Build Directory",
        },
        {
            "label": "[DSF] Build DuetPluginService",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/DuetPluginService -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "[DSF] Make Build Directory",
        },
        {
            "label": "[DSF] Build DuetWebServer",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/DuetWebServer -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "[DSF] Make Build Directory",
        },
        {
            "label": "[DSF] Build ModelObserver",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/ModelObserver -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "[DSF] Make Build Directory",
        },
        {
            "label": "[DSF] Build PluginManager",
            "type": "shell",
            "command": "dotnet build -r linux-arm64 --self-contained --no-restore ./src/PluginManager -o ./build",
            "args": [],
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOn": "[DSF] Make Build Directory",
        },
        {
            "label": "[DSF] Build All",
            "type": "shell",
            "command": "echo Build Complete",
            "args": [],
            "problemMatcher": [],
            "dependsOn": [
                "[DSF] Build CodeConsole",
                "[DSF] Build CodeLogger",
                "[DSF] Build CodeStream",
                "[DSF] Build CustomHttpEndpoint",
                "[DSF] Build DuetSbcInterface",
                "[DSF] Build DuetControlServer",
                "[DSF] Build DuetPiManagementPlugin",
                "[DSF] Build DuetPluginService",
                "[DSF] Build DuetWebServer",
                "[DSF] Build ModelObserver",
                "[DSF] Build PluginManager"
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOrder": "sequence"
        },
        {
            "label": "[DSF] Restore & Build All",
            "type": "shell",
            "command": "echo Build Complete",
            "args": [],
            "problemMatcher": [],
            "dependsOn": [
                "[DSF] Restore DSF Solution",
                "[DSF] Build All",
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "dependsOrder": "sequence"
        },
        {
            "label": "[DSF] Install vsdbg on Remote",
            "type": "shell",
            "command": "ssh -o StrictHostKeyChecking=no ${config:dsf.debug.sshUser}@${config:dsf.debug.targetIp} 'mkdir -p ~/vsdbg && curl -fsSL https://aka.ms/getvsdbgsh | bash /dev/stdin -v latest -l ~/vsdbg && ~/vsdbg/vsdbg --version'",
            "problemMatcher": []
        },
        {
            "label": "[DSF] Deploy To",
            "type": "shell",
            "command": "./scripts/build.sh --skip-build --target ${config:dsf.debug.targetIp} --user ${config:dsf.debug.sshUser} --start-services ${input:project_name}",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Deploy Local",
            "type": "shell",
            "command": "./scripts/build.sh --skip-build --local ${input:project_name}",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Build",
            "type": "shell",
            "command": "./scripts/build.sh ${input:project_name}",
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Build and Deploy To",
            "type": "shell",
            "command": "./scripts/build.sh --target ${config:dsf.debug.targetIp} --user ${config:dsf.debug.sshUser} --start-services ${input:project_name}",
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Build and Deploy Local",
            "type": "shell",
            "command": "./scripts/build.sh --local ${input:project_name}",
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Build and Deploy DCS to",
            "type": "shell",
            "command": "./scripts/build.sh --target ${config:dsf.debug.targetIp} --user ${config:dsf.debug.sshUser} --start-services DuetControlServer",
            "problemMatcher": [
                "$msCompile"
            ],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            // Native SPI transfer loop (libduet_sbc.so). Cross-compiled for aarch64; needs a Pi
            // sysroot to link against the target's glibc, which is fetched automatically the first
            // time a deploy target is available (see "[DSF] Fetch Pi Sysroot").
            "label": "[DSF] Build DuetSbcInterface",
            "type": "shell",
            "command": "./scripts/build.sh DuetSbcInterface",
            "problemMatcher": [
                "$gcc"
            ],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Build and Deploy DuetSbcInterface to",
            "type": "shell",
            "command": "./scripts/build.sh --target ${config:dsf.debug.targetIp} --user ${config:dsf.debug.sshUser} --start-services DuetSbcInterface",
            "problemMatcher": [
                "$gcc"
            ],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            // Refresh the cached sysroot, e.g. after upgrading the Pi's OS or glibc
            "label": "[DSF] Fetch Pi Sysroot",
            "type": "shell",
            "command": "./src/DuetSbcInterface/scripts/fetch-pi-sysroot.sh ${config:dsf.debug.sshUser}@${config:dsf.debug.targetIp} ./src/DuetSbcInterface/pi-sysroot",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            // The C# test suite (DCS, DuetAPI, DuetHttpClient). Runs natively for the host.
            // Note: the HttpClient/Session tests talk to a real printer over HTTP and fail in the
            // devcontainer unless one is reachable; append
            //   --filter "FullyQualifiedName!~UnitTests.HttpClient"
            // to skip them.
            "label": "[DSF] Run C# Unit Tests",
            "type": "shell",
            "command": "dotnet test ./src/UnitTests/UnitTests.csproj --nologo",
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "test",
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            // Host-side unit tests for the native interface (ring buffer framing/concurrency).
            // Builds natively for the host, so no Pi or sysroot is involved.
            "label": "[DSF] Run Native Tests",
            "type": "shell",
            "command": "cmake -S ./src/DuetSbcInterface -B ./src/DuetSbcInterface/build -DCMAKE_BUILD_TYPE=Release && cmake --build ./src/DuetSbcInterface/build -j && ctest --test-dir ./src/DuetSbcInterface/build --output-on-failure",
            "problemMatcher": [
                "$gcc"
            ],
            "group": "test",
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            // Builds and deploys the jitter harness, which measures RequestTransfer -> transfer
            // latency without the .NET runtime. Statically linked, so it needs no sysroot.
            "label": "[DSF] Build and Deploy Jitter Harness to",
            "type": "shell",
            "command": "cmake --preset pi-arm64 && cmake --build --preset pi-arm64 --target sbc_jitter_test -j && scp build-arm64/harness/sbc_jitter_test ${config:dsf.debug.sshUser}@${config:dsf.debug.targetIp}:~/",
            "options": {
                "cwd": "${workspaceFolder}/src/DuetSbcInterface"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Stop DSF Services",
            "type": "shell",
            "command": "ssh root@${config:dsf.debug.targetIp} 'systemctl stop duetcontrolserver duetwebserver duetpluginservice duetpluginservice-root'",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "[DSF] Restart DSF Services",
            "type": "shell",
            "command": "ssh root@${config:dsf.debug.targetIp} 'systemctl restart duetcontrolserver duetwebserver duetpluginservice duetpluginservice-root'",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "[DSF] Stop Remote DuetControlServer",
            "type": "shell",
            "command": "ssh ${config:dsf.debug.sshUser}@${config:dsf.debug.targetIp} 'systemctl stop duetcontrolserver'",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                // "reveal": "silent"
            }
        },
        {
            "label": "[DSF] Start Remote DuetControlServer",
            "type": "shell",
            "command": "ssh ${config:dsf.debug.sshUser}@${config:dsf.debug.targetIp} 'systemctl start duetcontrolserver'",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                // "reveal": "silent"
            }
        },
        {
            "label": "[DSF] Set Debug Target IP",
            "type": "shell",
            "command": "python3 scripts/create_settings.py --target-ip ${input:debug_target_ip}",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },

        // ---------------------------------------------------------------
        // DuetCANMaster firmware (src/DuetCANMaster). These run in the
        // submodule directory and build against the shared ./lib libraries.
        // ---------------------------------------------------------------
        {
            "label": "[CANMaster] Build Selected Target",
            "type": "shell",
            "command": "make ${input:fw_buildType} DuetCANMaster CANMASTER_CONFIG=${input:canmaster_target} LIBRARIES_DIR=${workspaceFolder}/lib -j",
            "problemMatcher": [ "$gcc" ],
            "group": "build"
        },
        {
            "label": "[CANMaster] Build Duet3_MB6HC - Debug",
            "type": "shell",
            "command": "make DEBUG=1 DuetCANMaster CANMASTER_CONFIG=Duet3_MB6HC LIBRARIES_DIR=${workspaceFolder}/lib -j",
            "problemMatcher": [ "$gcc" ],
            "group": "build"
        },
        {
            "label": "[CANMaster] Build Duet3_MB6HC - Release",
            "type": "shell",
            "command": "make DuetCANMaster CANMASTER_CONFIG=Duet3_MB6HC LIBRARIES_DIR=${workspaceFolder}/lib -j",
            "problemMatcher": [ "$gcc" ],
            "group": "build"
        },
        {
            "label": "[CANMaster] Build Duet3_MB6XD - Debug",
            "type": "shell",
            "command": "make DEBUG=1 DuetCANMaster CANMASTER_CONFIG=Duet3_MB6XD LIBRARIES_DIR=${workspaceFolder}/lib -j",
            "problemMatcher": [ "$gcc" ],
            "group": "build"
        },
        {
            "label": "[CANMaster] Build Duet3_MB6XD - Release",
            "type": "shell",
            "command": "make DuetCANMaster CANMASTER_CONFIG=Duet3_MB6XD LIBRARIES_DIR=${workspaceFolder}/lib -j",
            "problemMatcher": [ "$gcc" ],
            "group": "build"
        },
        {
            "label": "[CANMaster] Build Duet3Mini5plus - Debug",
            "type": "shell",
            "command": "make DEBUG=1 DuetCANMaster CANMASTER_CONFIG=Duet3Mini5plus LIBRARIES_DIR=${workspaceFolder}/lib -j",
            "problemMatcher": [ "$gcc" ],
            "group": "build"
        },
        {
            "label": "[CANMaster] Build Duet3Mini5plus - Release",
            "type": "shell",
            "command": "make DuetCANMaster CANMASTER_CONFIG=Duet3Mini5plus LIBRARIES_DIR=${workspaceFolder}/lib -j",
            "problemMatcher": [ "$gcc" ],
            "group": "build"
        },
        {
            "label": "[CANMaster] Clean All",
            "type": "shell",
            "command": "make DuetCANMaster.clean-all LIBRARIES_DIR=${workspaceFolder}/lib",
            "problemMatcher": [ "$gcc" ],
            "group": "build"
        },
        {
            "label": "[CANMaster] Clean Duet3_MB6HC",
            "type": "shell",
            "command": "make DuetCANMaster.clean CANMASTER_CONFIG=Duet3_MB6HC LIBRARIES_DIR=${workspaceFolder}/lib",
            "problemMatcher": [ "$gcc" ],
            "group": "build"
        },
        {
            "label": "[CANMaster] Clean Duet3_MB6XD",
            "type": "shell",
            "command": "make DuetCANMaster.clean CANMASTER_CONFIG=Duet3_MB6XD LIBRARIES_DIR=${workspaceFolder}/lib",
            "problemMatcher": [ "$gcc" ],
            "group": "build"
        },
        {
            "label": "[CANMaster] Clean Duet3Mini5plus",
            "type": "shell",
            "command": "make DuetCANMaster.clean CANMASTER_CONFIG=Duet3Mini5plus LIBRARIES_DIR=${workspaceFolder}/lib",
            "problemMatcher": [ "$gcc" ],
            "group": "build"
        },
        {
            "label": "[CANMaster] Upload Selected Target (rr_upload)",
            "type": "shell",
            "command": "./Scripts/rr_upload_selected_target.sh",
            "args": [
                "${input:canmaster_target}",
                "${input:duetHost}",
                "${input:duetPassword}"
            ],
            "options": { "cwd": "${workspaceFolder}/src/DuetCANMaster" },
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "[CANMaster] Flash Firmware (M997)",
            "type": "shell",
            "command": "./Scripts/rr_send_gcode.sh",
            "args": [
                "${input:duetHost}",
                "${input:duetPassword}",
                "M997"
            ],
            "options": { "cwd": "${workspaceFolder}/src/DuetCANMaster" },
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "[CANMaster] Build and Deploy to Target",
            "dependsOn": [
                "[CANMaster] Build Selected Target",
                "[CANMaster] Upload Selected Target (rr_upload)",
                "[CANMaster] Flash Firmware (M997)"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },

        // ---------------------------------------------------------------
        // Duet3Expansion firmware (src/Duet3Expansion). These run in the
        // submodule directory and build against the shared ./lib libraries.
        // ---------------------------------------------------------------
        {
            "label": "[Expansion] Build Selected Target",
            "type": "shell",
            "command": "make ${input:fw_buildType} ${input:expansion_target} LIBRARIES_DIR=${workspaceFolder}/lib -j",
            "problemMatcher": [ "$gcc" ],
            "group": "build"
        },
        {
            "label": "[Expansion] Build EXP1HCL - Debug",
            "type": "shell",
            "command": "make DEBUG=1 EXP1HCL LIBRARIES_DIR=${workspaceFolder}/lib -j",
            "problemMatcher": [ "$gcc" ],
            "group": "build"
        },
        {
            "label": "[Expansion] Clean All",
            "type": "shell",
            "command": "make Duet3Expansion.clean-all LIBRARIES_DIR=${workspaceFolder}/lib",
            "problemMatcher": [ "$gcc" ],
            "group": "build"
        },
        {
            "label": "[Style] Format DuetCANMaster",
            "type": "shell",
            "command": "clang-format -i --style=file $(find src -name '*.cpp' -o -name '*.h' | grep -vE '^src/(libc|libcpp)/')",
            "options": { "cwd": "${workspaceFolder}/src/DuetCANMaster" },
            "problemMatcher": [],
            "group": "build",
            "detail": "Reformat first-party sources. Skips src/libc and src/libcpp (vendored newlib/GCC runtime)."
        },
        {
            "label": "[Style] Format DuetSbcInterface",
            "type": "shell",
            "command": "clang-format -i --style=file $(find sbc harness tests -name '*.cpp' -o -name '*.h')",
            "options": { "cwd": "${workspaceFolder}/src/DuetSbcInterface" },
            "problemMatcher": [],
            "group": "build",
            "detail": "Reformat sbc/, harness/ and tests/."
        },
        {
            "label": "[Style] Check Formatting (both projects)",
            "type": "shell",
            "command": "cd ${workspaceFolder}/src/DuetCANMaster && clang-format --dry-run --Werror --style=file $(find src -name '*.cpp' -o -name '*.h' | grep -vE '^src/(libc|libcpp)/') && cd ${workspaceFolder}/src/DuetSbcInterface && clang-format --dry-run --Werror --style=file $(find sbc harness tests -name '*.cpp' -o -name '*.h') && echo 'Formatting OK'",
            "problemMatcher": [ "$gcc" ],
            "group": "test",
            "detail": "Non-mutating check; exits non-zero if anything would be reformatted. Suitable for CI."
        },
        {
            "label": "[Style] Generate Compile DB - DuetCANMaster",
            "type": "shell",
            "command": "Scripts/gen-compile-commands.sh ${input:canmaster_board}",
            "options": { "cwd": "${workspaceFolder}/src/DuetCANMaster" },
            "problemMatcher": [ "$gcc" ],
            "group": "build",
            "detail": "Clean build under bear, then rewrite the database so clang can parse it. Required before Tidy."
        },
        {
            "label": "[Style] Generate Compile DB - DuetSbcInterface",
            "type": "shell",
            "command": "cmake -S . -B build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
            "options": { "cwd": "${workspaceFolder}/src/DuetSbcInterface" },
            "problemMatcher": [ "$gcc" ],
            "group": "build",
            "detail": "CMake exports compile_commands.json into build/."
        },
        {
            "label": "[Style] Tidy DuetCANMaster",
            "type": "shell",
