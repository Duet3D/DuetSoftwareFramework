{
    "version": 4,
    "configurations": [
        {
            "name": "Duet (firmware + SBC) - CMake Tools",
            // CMake Tools serves per-file flags for whichever project is active. cmake.sourceDirectory
            // lists two projects and only the active one gets provider coverage, so the databases
            // below backstop it - for files it cannot answer for, cpptools falls through to them.
            "configurationProvider": "ms-vscode.cmake-tools"
        },
        {
            "name": "Duet3Expansion - Makefile Tools",
            "configurationProvider": "ms-vscode.makefile-tools"
        }
    ]
}
