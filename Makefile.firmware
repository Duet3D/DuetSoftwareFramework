# Firmware make build
# Builds RepRapFirmware (main boards), Duet3Expansion (expansion/tool boards), Duet3Bootloader
# (bootloaders and CAN IAPs) and DuetIAP (firmware update IAPs) against the shared libraries in lib/.
# The CMake build (CMakeLists.txt, scripts/build.py) is the default and also builds DuetCANMaster,
# which has no make build; this one is kept so that CI can check the two produce identical images.
#
# The top-level Makefile forwards the targets here, so 'make EXP1HCL' and
# 'make -f Makefile.firmware EXP1HCL' are the same. Each board is a target. Bootloader and IAP boards
# are prefixed with 'bootloader-' and 'iap-' because some of their names clash with the firmware
# boards.

ROOT    := $(CURDIR)
LIB_DIR := $(ROOT)/lib
RRF_DIR := $(ROOT)/src/RepRapFirmware
D3E_DIR := $(ROOT)/src/Duet3Expansion
BL_DIR  := $(ROOT)/src/Duet3Bootloader
IAP_DIR := $(ROOT)/src/DuetIAP

# Quiet build support - use V=1 for verbose output (passed through to the projects)
ifeq ($(V),1)
Q :=
else
Q := @
endif

# Board configurations are read from the project Makefiles so they track submodule updates
RRF_CONFIGS := $(shell sed -n 's/^CONFIGS[[:space:]]*:=//p' $(RRF_DIR)/Makefile)
D3E_CONFIGS := $(shell sed -n 's/^CONFIGS[[:space:]]*:=//p' $(D3E_DIR)/Makefile)
BL_CONFIGS  := $(shell sed -n 's/^CONFIGS[[:space:]]*:=//p' $(BL_DIR)/Makefile)
IAP_CONFIGS := $(shell sed -n 's/^\(SD\|SBC\)_CONFIGS[[:space:]]*:=//p' $(IAP_DIR)/Makefile)
CONFIGS     := $(RRF_CONFIGS) $(D3E_CONFIGS)
BL_TARGETS  := $(addprefix bootloader-,$(BL_CONFIGS))
IAP_TARGETS := $(addprefix iap-,$(IAP_CONFIGS))

# Use the toolchain on PATH (the devcontainer installs it there) unless CROSS_COMPILE is given
CROSS_COMPILE ?= $(patsubst %gcc,%,$(shell command -v arm-none-eabi-gcc))
ifeq ($(CROSS_COMPILE),)
$(error arm-none-eabi-gcc not found on PATH - install the ARM GNU toolchain or set CROSS_COMPILE)
endif

# The firmware and bootloader builds always append a CRC; use CrcAppender from PATH, else the copy shipped with RepRapFirmware
CRC_APPENDER ?= $(or $(shell command -v CrcAppender),$(RRF_DIR)/Tools/CrcAppender/linux-$(shell uname -m)/CrcAppender)

# The projects find their libraries at $(LIBRARIES_DIR)/<lib>, defaulting to alongside the project
SUBMAKE_VARS := LIBRARIES_DIR=$(LIB_DIR) CROSS_COMPILE=$(CROSS_COMPILE) CRC_APPENDER=$(CRC_APPENDER)

# $(call project_dir,<config>) - project directory that builds <config>
project_dir = $(if $(filter $(1),$(RRF_CONFIGS)),$(RRF_DIR),$(if $(filter $(1),$(D3E_CONFIGS)),$(D3E_DIR)))

# All projects drive the same library builds, so only one project may build at a time
# (recursive makes still run their recipes in parallel)
.NOTPARALLEL:

.DEFAULT_GOAL := help

.PHONY: help
help:
	$(Q)echo ""
	$(Q)echo "DuetFirmware Build System"
	$(Q)echo "========================="
	$(Q)echo ""
	$(Q)echo "RepRapFirmware configurations:"
	$(Q)for c in $(RRF_CONFIGS); do echo "  $$c"; done
	$(Q)echo ""
	$(Q)echo "Duet3Expansion configurations:"
	$(Q)for c in $(D3E_CONFIGS); do echo "  $$c"; done
	$(Q)echo ""
	$(Q)echo "Duet3Bootloader configurations:"
	$(Q)for c in $(BL_TARGETS); do echo "  $$c"; done
	$(Q)echo ""
	$(Q)echo "DuetIAP configurations:"
	$(Q)for c in $(IAP_TARGETS); do echo "  $$c"; done
	$(Q)echo ""
	$(Q)echo "Targets:"
	$(Q)echo "  <config>            - Build a specific configuration"
	$(Q)echo "  rrf                 - Build all RepRapFirmware configurations"
	$(Q)echo "  d3e                 - Build all Duet3Expansion configurations"
	$(Q)echo "  bootloader          - Build all Duet3Bootloader configurations"
	$(Q)echo "  iap                 - Build all DuetIAP configurations"
	$(Q)echo "  all                 - Build everything (rrf + d3e + bootloader + iap)"
	$(Q)echo "  clean               - Clean all build outputs"
	$(Q)echo "  clean-all           - Clean all build outputs and libraries"
	$(Q)echo "  clean-<config>      - Clean a specific configuration"
	$(Q)echo "  print-targets       - List every buildable configuration, one per line"
	$(Q)echo ""
	$(Q)echo "Variables:"
	$(Q)echo "  CROSS_COMPILE       - Toolchain prefix (default: $(CROSS_COMPILE))"
	$(Q)echo "  CRC_APPENDER        - CrcAppender used by the builds (default: $(CRC_APPENDER))"
	$(Q)echo "  V=1                 - Enable verbose build output"
	$(Q)echo "  DEBUG=1             - Build with debug symbols (-g3 -Og)"
	$(Q)echo ""
	$(Q)echo "Examples:"
	$(Q)echo "  make -j16 EXP1HCL                         # Build the 1HCL"
	$(Q)echo "  make -j16 Duet3_MB6HC DEBUG=1             # Build the 6HC with debug symbols"
	$(Q)echo "  make -j16 bootloader-SAME5x               # Build the SAME5x bootloader"
	$(Q)echo ""

# One buildable target per line, used by CI to build every target as a separate job
.PHONY: print-targets
print-targets:
	$(Q)for t in $(CONFIGS) $(BL_TARGETS) $(IAP_TARGETS); do echo "$$t"; done

.PHONY: $(CONFIGS)
$(CONFIGS):
	$(Q)$(MAKE) -C $(call project_dir,$@) $(SUBMAKE_VARS) $@

.PHONY: rrf
rrf:
	$(Q)$(MAKE) -C $(RRF_DIR) $(SUBMAKE_VARS) all

.PHONY: d3e
d3e:
	$(Q)$(MAKE) -C $(D3E_DIR) $(SUBMAKE_VARS) all

.PHONY: $(BL_TARGETS)
$(BL_TARGETS): bootloader-%:
	$(Q)$(MAKE) -C $(BL_DIR) $(SUBMAKE_VARS) $*

.PHONY: $(IAP_TARGETS)
$(IAP_TARGETS): iap-%:
	$(Q)$(MAKE) -C $(IAP_DIR) $(SUBMAKE_VARS) $*

.PHONY: bootloader
bootloader:
	$(Q)$(MAKE) -C $(BL_DIR) $(SUBMAKE_VARS) all

.PHONY: iap
iap:
	$(Q)$(MAKE) -C $(IAP_DIR) $(SUBMAKE_VARS) all

.PHONY: all
all: rrf d3e bootloader iap

# Each configuration builds into a directory of the same name inside its project
# (removed directly because Duet3Expansion does not load board makefiles for clean-<config>)
.PHONY: $(addprefix clean-,$(CONFIGS))
$(addprefix clean-,$(CONFIGS)):
	$(Q)echo "  RM      $(patsubst clean-%,%,$@)"
	$(Q)rm -rf $(call project_dir,$(patsubst clean-%,%,$@))/$(patsubst clean-%,%,$@)

.PHONY: $(addprefix clean-,$(BL_TARGETS))
$(addprefix clean-,$(BL_TARGETS)): clean-bootloader-%:
	$(Q)echo "  RM      $*"
	$(Q)rm -rf $(BL_DIR)/$*

.PHONY: $(addprefix clean-,$(IAP_TARGETS))
$(addprefix clean-,$(IAP_TARGETS)): clean-iap-%:
	$(Q)echo "  RM      $*"
	$(Q)rm -rf $(IAP_DIR)/$*

# Duet3Bootloader's own clean also cleans the libraries, so its outputs are removed directly
.PHONY: clean
clean: $(addprefix clean-,$(BL_TARGETS))
	$(Q)$(MAKE) -C $(RRF_DIR) $(SUBMAKE_VARS) clean
	$(Q)$(MAKE) -C $(D3E_DIR) $(SUBMAKE_VARS) clean
	$(Q)$(MAKE) -C $(IAP_DIR) $(SUBMAKE_VARS) clean

.PHONY: clean-all
clean-all:
	$(Q)$(MAKE) -C $(RRF_DIR) $(SUBMAKE_VARS) clean-all
	$(Q)$(MAKE) -C $(D3E_DIR) $(SUBMAKE_VARS) clean-all
	$(Q)$(MAKE) -C $(BL_DIR) $(SUBMAKE_VARS) clean-all
	$(Q)$(MAKE) -C $(IAP_DIR) $(SUBMAKE_VARS) clean-all
