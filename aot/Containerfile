# Build environment for .NET NativeAOT cross-builds of DSF.
#
# Based on bookworm so the sysroots match DuetPi's glibc 2.36. Using clang as the linker driver
# avoids the --target= incompatibility of the GCC cross drivers, and Debian's cross binutils provide
# the armelf_linux_eabi support that a typical x86 host toolchain lacks
FROM debian:bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
		binutils-aarch64-linux-gnu \
		binutils-arm-linux-gnueabihf \
		ca-certificates \
		clang \
		curl \
		dpkg-dev \
		gcc-aarch64-linux-gnu \
		gcc-arm-linux-gnueabihf \
		jq \
		libc6-dev-arm64-cross \
		libc6-dev-armhf-cross \
		libxml2-utils \
		rsync \
		xz-utils \
		zlib1g-dev \
	&& rm -rf /var/lib/apt/lists/*

# The AOT targets ask clang for the armv7-linux-gnueabihf triple, but Debian names its cross tools
# arm-linux-gnueabihf-*. Without matching names clang silently falls back to the host x86 linker
RUN ln -s arm-linux-gnueabihf-ld /usr/bin/armv7-linux-gnueabihf-ld \
	&& ln -s arm-linux-gnueabihf-ld.bfd /usr/bin/armv7-linux-gnueabihf-ld.bfd \
	&& ln -s arm-linux-gnueabihf-objcopy /usr/bin/armv7-linux-gnueabihf-objcopy

RUN curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
	&& bash /tmp/dotnet-install.sh --channel 10.0 --install-dir /usr/share/dotnet \
	&& ln -s /usr/share/dotnet/dotnet /usr/bin/dotnet \
	&& rm /tmp/dotnet-install.sh

ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
	DOTNET_NOLOGO=1 \
	DOTNET_CLI_HOME=/tmp \
	DOTNET_SKIP_FIRST_TIME_EXPERIENCE=true

WORKDIR /src
